er): BossSpawnPlan.Entry {\n        let spawnImage = GameAssets.bossImageForTypeFrame(type, 0)\n        let point = chooseSpawnPoint(type, index, total, spawnImage)\n        return new BossSpawnPlan.Entry(type, hp, point[0], point[1], point[2], point[3], point[4])\n    }\n    function chooseSpawnPoint(type: number, index: number, total: number, spawnImage: Image): number[] {\n        if (type == BossRegistry.TYPE_WALL) {\n            let side = (GameSession.isCustomBossMode() && total > 1) ? index % 4 : BossMovementSystem.pickPreferredWallSide()\n            let cx = WorldSystem.getCameraX(), cy = WorldSystem.getCameraY()\n            let left = cx - GameConfig.SCREEN_WIDTH / 2, top = cy - GameConfig.SCREEN_HEIGHT / 2\n            let hw = spawnImage.width / 2, hh = spawnImage.height / 2\n            let minAxis = (side == 0 || side == 1) ? hh : hw\n            let maxAxis = (side == 0 || side == 1) ? GameConfig.SCREEN_HEIGHT - hh : GameConfig.SCREEN_WIDTH - hw\n            let inset = 4\n            let usable = Math.max(1, maxAxis - minAxis - inset * 2)\n            let startAxis = (GameSession.isCustomBossMode() && total > 1) ? minAxis + inset + Math.idiv(usable * (index + 1), total + 1) : (index % 2 == 0 ? minAxis + inset : maxAxis - inset)\n            let finishAxis = maxAxis - (startAxis - minAxis)\n            if (side == 0) return [left + hw, top + startAxis, side, startAxis, finishAxis]\n            if (side == 1) return [left + GameConfig.SCREEN_WIDTH - hw, top + startAxis, side, startAxis, finishAxis]\n            if (side == 2) return [left + startAxis, top + hh, side, startAxis, finishAxis]\n            return [left + startAxis, top + GameConfig.SCREEN_HEIGHT - hh, side, startAxis, finishAxis]\n        }\n        let cx = Math.idiv(GameConfig.WORLD_WIDTH, 2), cy = Math.idiv(GameConfig.WORLD_HEIGHT, 2)\n        if (total <= 1) return [cx, cy, -1, -1, -1]\n        if (total == 2) return [cx + (index == 0 ? -14 : 14), cy, -1, -1, -1]\n        let offset = (index * 2 - (total - 1)) * 12\n        return [cx + offset, cy, -1, -1, -1]\n    }\n    function updateWallPosition(entry: BossSpawnPlan.Entry, elapsed: number) {\n        if (entry == null || entry.type != BossRegistry.TYPE_WALL) return\n        let side = entry.wallSide\n        let p = Math.idiv(Math.max(0, Math.min(GameConfig.BOSS_SPAWN_INTRO_MS, elapsed)) * 1000, GameConfig.BOSS_SPAWN_INTRO_MS)\n        let eased = Math.idiv(p * (2000 - p), 1000)\n        let axis = entry.wallStartAxis + Math.idiv((entry.wallEndAxis - entry.wallStartAxis) * eased, 1000)\n        let cx = WorldSystem.getCameraX(), cy = WorldSystem.getCameraY()\n        let left = cx - GameConfig.SCREEN_WIDTH / 2, top = cy - GameConfig.SCREEN_HEIGHT / 2\n        let wallImage = GameAssets.bossImageForTypeFrame(BossRegistry.TYPE_WALL, 0)\n        let hw = wallImage.width / 2, hh = wallImage.height / 2\n        if (side == 0) { entry.x = left + hw; entry.y = top + axis }\n        else if (side == 1) { entry.x = left + GameConfig.SCREEN_WIDTH - hw; entry.y = top + axis }\n        else if (side == 2) { entry.x = left + axis; entry.y = top + hh }\n        else { entry.x = left + axis; entry.y = top + GameConfig.SCREEN_HEIGHT - hh }\n    }\n    function introImage(elapsed: number): Image {\n        let size = GameConfig.BOSS_SPAWN_RING_MAX_SIZE\n        if (introRaster == null) introRaster = image.create(size, size)\n        let out = introRaster; out.fill(0)\n        let c = Math.idiv(size, 2)\n        let minR = Math.idiv(GameConfig.BOSS_SPAWN_RING_MIN_SIZE, 2), maxR = c - 2\n        for (let ring = 0; ring < GameConfig.BOSS_SPAWN_INTRO_RING_COUNT; ring++) {\n            let ringStartAt = ring * GameConfig.BOSS_SPAWN_RING_START_STEP_MS\n            let finishAt = GameConfig.BOSS_SPAWN_RING_FIRST_FINISH_MS + ring * GameConfig.BOSS_SPAWN_RING_FINISH_STEP_MS\n            if (finishAt > GameConfig.BOSS_SPAWN_INTRO_MS) finishAt = GameConfig.BOSS_SPAWN_INTRO_MS\n            if (elapsed >= finishAt) continue\n            let local = 0\n            if (elapsed > ringStartAt) local = Math.idiv((elapsed - ringStartAt) * 1000, Math.max(1, finishAt - ringStartAt))\n            if (local < 0) local = 0; if (local > 1000) local = 1000\n            let eased = local\n            if (ring % 3 == 0) eased = Math.idiv(local * local, 1000)\n            else if (ring % 3 == 1) { let inv = 1000 - local; eased = 1000 - Math.idiv(inv * inv, 1000) }\n            else { let quad = Math.idiv(local * local, 1000); eased = Math.idiv(quad * (3000 - 2 * local), 1000) }\n            let startR = maxR - ring * 8; if (startR < minR + 3) startR = minR + 3\n            let r = minR + Math.idiv((startR - minR) * (1000 - eased), 1000)\n            let color = ring % 4 == 0 ? 1 : (ring % 4 == 1 ? 12 : (ring % 4 == 2 ? 5 : 10))\n            for (let deg = 0; deg < 360; deg += 5) {\n                let rad = deg * Math.PI / 180, x = Math.round(c + Math.cos(rad) * r), y = Math.round(c + Math.sin(rad) * r)\n                if (x >= 0 && x < size && y >= 0 && y < size) out.setPixel(x, y, color)\n            }\n        }\n        return out\n    }\n    function clearEffects() {\n        for (let entry of entries) if (entry != null && entry.effect != null) { entry.effect.destroy(); entry.effect = null }\n    }\n    export function start(newEntries: BossSpawnPlan.Entry[]) {\n        clearEffects()\n        entries = newEntries\n        active = true\n        startAt = game.runtime()\n        endAt = startAt + GameConfig.BOSS_SPAWN_INTRO_MS\n        lastFrame = -1\n        for (let entry of entries) {\n            let fx = sprites.create(image.create(GameConfig.BOSS_SPAWN_RING_MAX_SIZE, GameConfig.BOSS_SPAWN_RING_MAX_SIZE), SpriteKind.BossTelegraph)\n            fx.setFlag(SpriteFlag.Ghost, true); fx.setFlag(SpriteFlag.AutoDestroy, false)\n            fx.z = GameConfig.BOSS_Z + 4\n            fx.setPosition(entry.x, entry.y)\n            entry.effect = fx\n        }\n        SoundSystem.bossSpawnCharge()\n        scene.cameraShake(5, GameConfig.BOSS_SPAWN_INTRO_MS)\n        update()\n    }\n    export function update(): boolean {\n        if (!active) return false\n        let now = game.runtime(), elapsed = now - startAt; if (elapsed < 0) elapsed = 0\n        let frame = Math.idiv(elapsed, GameConfig.BOSS_SPAWN_RING_FRAME_MS)\n        if (frame != lastFrame) {\n            lastFrame = frame\n            let frameImage = introImage(elapsed)\n            for (let entry of entries) if (entry != null && entry.effect != null) {\n                if (entry.type == BossRegistry.TYPE_WALL) updateWallPosition(entry, elapsed)\n                entry.effect.setPosition(entry.x, entry.y)\n                entry.effect.setImage(frameImage)\n            }\n        }\n        if (now < endAt) return false\n        active = false\n        clearEffects()\n        return true\n    }\n}\nnamespace BossVisualSystem {\n    let rageMarkImageCache: Image = null\n    export function reset() {\n        rageMarkImageCache = null\n    }\n    function rageTintImage(source: Image): Image {\n        return source\n    }\n    function rageMarkImage(): Image {\n        if (rageMarkImageCache != null) return rageMarkImageCache\n        let markImg: Image = img`\n            . 2 . 2 .\n            2 2 . 2 2\n            . . . . .\n            2 2 . 2 2\n            . 2 . 2 .\n        `\n        rageMarkImageCache = markImg\n        return markImg\n    }\n    export function updateRage(rt: BossRuntimeSystem.BossRuntime, index: number) {\n        if (rt == null || rt.sprite == null || !BossSystem.isEnemyEnraged(index)) return\n        let now = game.runtime()\n        if (!rt.enrageTriggered) {\n            rt.enrageTriggered = true\n            SoundSystem.bossEnrage()\n            scene.cameraShake(2, 150)\n            let base = GameAssets.bossImageForTypeFrame(rt.type, rt.animationFrame)\n            if (rt.type == BossRegistry.TYPE_RUSH && BossRushSpecial.isDashing(rt.sprite, now)) base = BossRushSpecial.dashImage(rt.sprite, rt.animationFrame)\n            rt.sprite.setImage(rageTintImage(base))\n        }\n        if (now - rt.lastRageParticleAt < GameConfig.BOSS_ENRAGE_PARTICLE_INTERVAL_MS) return\n        rt.lastRageParticleAt = now\n        let owner = rt.sprite\n        let mark = sprites.create(rageMarkImage(), SpriteKind.BossTelegraph)\n        mark.setFlag(SpriteFlag.Ghost, true)\n        mark.z = GameConfig.BOSS_Z + 8\n        mark.setPosition(owner.x + randint(-8, 8), owner.y - 10 + randint(-3, 2))\n        let startY = mark.y\n        control.runInParallel(function () {\n            let born = game.runtime()\n            while (game.runtime() - born < GameConfig.BOSS_ENRAGE_PARTICLE_LIFETIME_MS && mark != null) {\n                mark.y = startY - Math.idiv(game.runtime() - born, 150)\n                pause(35)\n            }\n            if (mark != null) mark.destroy()\n        })\n    }\n    export function updateAnimation(rt: BossRuntimeSystem.BossRuntime, index: number) {\n        if (rt == null || rt.sprite == null) return\n        let now = game.runtime()\n        if (now - rt.lastAnimationAt < GameConfig.BOSS_ANIMATION_INTERVAL_MS) return\n        rt.lastAnimationAt = now\n        rt.animationFrame = (rt.animationFrame + 1) % 2\n        let frame: Image\n        if (rt.type == BossRegistry.TYPE_RUSH && BossRushSpecial.isDashing(rt.sprite, now)) frame = BossRushSpecial.dashImage(rt.sprite, rt.animationFrame)\n        else frame = GameAssets.bossImageForTypeFrame(rt.type, rt.animationFrame)\n        if (BossSystem.isEnemyEnraged(index)) frame = rageTintImage(frame)\n        rt.sprite.setImage(frame)\n    }\n    export function clearEnemyTrail(index: number) {\n        let rt = BossRuntimeSystem.get(index)\n        if (rt == null) return\n        if (rt.sprite != null) TrailRibbonSystem.clearOwner(rt.sprite)\n        rt.lastTrailSpawnAt = 0\n        rt.trailMoveCount = 0\n    }\n    export function clearAllTrails() {\n        for (let index = 0; index < BossRuntimeSystem.count(); index++)clearEnemyTrail(index)\n        TrailRibbonSystem.clearKind(SpriteKind.BossTrail)\n    }\n    export function updateTrail(rt: BossRuntimeSystem.BossRuntime, encounterAlive: boolean) {\n        if (rt == null || rt.sprite == null || !encounterAlive) return\n        let owner = rt.sprite\n        let now = game.runtime()\n        let isRush = rt.type == BossRegistry.TYPE_RUSH\n        let dashFlag = isRush && (BossRushSpecial.isDashing(owner, now) || (rt.rushChargeEndsAt > 0 && now < rt.rushChargeEndsAt))\n        let duration = dashFlag ? GameConfig.BOSS_RUSH_DASH_TRAIL_DURATION_MS : GameConfig.BOSS_TRAIL_DURATION_MS\n        let baseLayers = isRush ? GameConfig.BOSS_RUSH_TRAIL_BASE_LAYERS : GameConfig.BOSS_TRAIL_BASE_LAYERS\n        let maxLayers = isRush ? GameConfig.BOSS_RUSH_TRAIL_MAX_LAYERS : GameConfig.BOSS_TRAIL_MAX_LAYERS\n        let layerCount = baseLayers + Math.idiv(rt.trailMoveCount, GameConfig.BOSS_TRAIL_MOVE_STEPS_PER_LAYER)\n        if (layerCount > maxLayers) layerCount = maxLayers\n        let sampleAge = now - rt.lastTrailSpawnAt\n        let sampleMinMs = isRush ? GameConfig.BOSS_RUSH_TRAIL_SAMPLE_MIN_MS : GameConfig.BOSS_TRAIL_SAMPLE_MIN_MS\n        if (rt.lastTrailSpawnAt > 0 && sampleAge < sampleMinMs) return\n        let trailX = owner.x, trailY = owner.y, relative = false\n        if (rt.type == BossRegistry.TYPE_WALL) {\n            relative = true\n            trailX = owner.x - WorldSystem.getCameraX() + GameConfig.SCREEN_WIDTH / 2\n            trailY = owner.y - WorldSystem.getCameraY() + GameConfig.SCREEN_HEIGHT / 2\n        }\n        if (rt.lastTrailSpawnAt <= 0) {\n            rt.lastTrailSpawnAt = now\n            rt.lastTrailX = trailX\n            rt.lastTrailY = trailY\n            return\n        }\n        let dx = trailX - rt.lastTrailX, dy = trailY - rt.lastTrailY\n        let d2 = dx * dx + dy * dy\n        let normalD = isRush ? GameConfig.BOSS_RUSH_TRAIL_SAMPLE_DISTANCE : GameConfig.BOSS_TRAIL_SAMPLE_DISTANCE\n        let forceD = isRush ? GameConfig.BOSS_RUSH_TRAIL_SAMPLE_FORCE_DISTANCE : GameConfig.BOSS_TRAIL_SAMPLE_FORCE_DISTANCE\n        if (d2 >= 0.01) rt.trailLastMovingAt = now\n        if (d2 < normalD * normalD) {\n            if (sampleAge < GameConfig.BOSS_TRAIL_SAMPLE_MAX_WAIT_MS || d2 < forceD * forceD) {\n                if (now - rt.trailLastMovingAt > 320) rt.trailMoveCount = 0\n                return\n            }\n        }\n        if (d2 > 900) {\n            rt.lastTrailSpawnAt = now\n            rt.lastTrailX = trailX\n            rt.lastTrailY = trailY\n            return\n        }\n        rt.trailLastMovingAt = now\n        rt.trailMoveCount += 1\n        let x0 = rt.lastTrailX, y0 = rt.lastTrailY, x1 = trailX, y1 = trailY\n        rt.lastTrailSpawnAt = now\n        rt.lastTrailX = trailX\n        rt.lastTrailY = trailY\n        let baseRadius = Math.max(1, Math.floor(Math.min(owner.width, owner.height) / 2) - 1)\n        if (dashFlag) baseRadius = 3\n        let edgeColor = dashFlag ? 2 : GameAssets.bossTrailHueForType(rt.type)\n        let midColor = GameAssets.trailMidColorForEdge(edgeColor)\n        TrailRibbonSystem.spawnSegment(\n            owner, SpriteKind.BossTrail, x0, y0, x1, y1,\n            baseRadius, baseRadius, edgeColor, midColor, duration, GameConfig.BOSS_Z - 1, relative, layerCount\n        )\n    }\n}\nnamespace BossDeathFxSystem {\n    let explosionFrames: Image[] = []\n    let shockwaveFrames: Image[] = []\n    function explosionFrame(frame: number): Image {\n        if (explosionFrames[frame] != null) return explosionFrames[frame]\n        let size = 81, out = image.create(size, size), c = Math.idiv(size, 2)\n        let r = 7 + frame * 3; if (r > 37) r = 37\n        let inner = Math.max(0, r - 7)\n        for (let y = 0; y < size; y++)for (let x = 0; x < size; x++) {\n            let dx = x - c, dy = y - c, d2 = dx * dx + dy * dy\n            if (d2 <= r * r && d2 >= inner * inner) {\n                let color = frame < 3 ? 1 : (frame < 7 ? 5 : 4)\n                if ((x + y + frame) % 4 == 0) color = 2\n                out.setPixel(x, y, color)\n            }\n            let coreR = Math.max(2, r - 13)\n            if (frame < 7 && d2 <= coreR * coreR) out.setPixel(x, y, (x + y + frame) % 3 == 0 ? 1 : 5)\n        }\n        for (let n = 0; n < 16; n++) {\n            let a = (n * 22.5 + frame * 13) * Math.PI / 180\n            for (let step = 0; step < 5; step++) {\n                let rr = r + 2 + step * 2 + (n % 2)\n                let x = Math.round(c + Math.cos(a) * rr), y = Math.round(c + Math.sin(a) * rr)\n                if (x >= 0 && x < size && y >= 0 && y < size) out.setPixel(x, y, step < 2 ? 1 : (n % 2 == 0 ? 5 : 4))\n            }\n        }\n        explosionFrames[frame] = out\n        return out\n    }\n    function shockwaveFrame(frame: number): Image {\n        if (shockwaveFrames[frame] != null) return shockwaveFrames[frame]\n        let size = 111, out = image.create(size, size), c = Math.idiv(size, 2), r = 8 + frame * 9; if (r > 52) r = 52\n        for (let band = 0; band < 2; band++) {\n            let rr = r - band * 3\n            if (rr < 2) continue\n            for (let deg = 0; deg < 360; deg += 3) {\n                let rad = deg * Math.PI / 180, x = Math.round(c + Math.cos(rad) * rr), y = Math.round(c + Math.sin(rad) * rr)\n                if (x >= 0 && x < size && y >= 0 && y < size) out.setPixel(x, y, band == 0 ? (frame < 2 ? 1 : 5) : 4)\n            }\n        }\n        shockwaveFrames[frame] = out\n        return out\n    }\n    export function show(deathX: number, deathY: number, screenLocked: boolean) {\n        scene.cameraShake(8, 760)\n        let fx = sprites.create(explosionFrame(0), SpriteKind.BossDeathEffect)\n        let wave = sprites.create(shockwaveFrame(0), SpriteKind.BossDeathEffect)\n        fx.setFlag(SpriteFlag.Ghost, true); wave.setFlag(SpriteFlag.Ghost, true)\n        fx.setFlag(SpriteFlag.AutoD