 vy: number, img: Image) {\n        let bullet = sprites.create(img, SpriteKind.BossBullet)\n        bullet.z = GameConfig.BOSS_BULLET_Z\n        bullet.setFlag(SpriteFlag.AutoDestroy, false)\n        bullet.setPosition(x, y); bullet.vx = vx; bullet.vy = vy\n    }\n}\nnamespace MinionGhostBehavior {\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, speed: number) {\n        MinionBehaviorShared.moveCurvedPursuit(r, nx, ny, 24 * speed, 7 * speed, 0.19)\n    }\n}\nnamespace MinionBatBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let dx = a.vx, dy = a.vy, d = Math.sqrt(dx * dx + dy * dy)\n        if (d < 1) { let angle = (phase % 8) * Math.PI / 4; dx = Math.cos(angle); dy = Math.sin(angle); d = 1 }\n        let nx = dx / d, ny = dy / d, px = -ny, py = nx\n        let side = phase % 2 == 0 ? 1 : -1\n        let spawnOffset = elite ? 7 : 5\n        let forward = elite ? 58 : 52\n        let inward = (elite ? 19 : 15) * side\n        MinionBehaviorShared.fireBullet(a.x + px * spawnOffset, a.y + py * spawnOffset, nx * forward - px * inward, ny * forward - py * inward, GameAssets.bossBulletBlue())\n        MinionBehaviorShared.fireBullet(a.x - px * spawnOffset, a.y - py * spawnOffset, nx * forward + px * inward, ny * forward + py * inward, GameAssets.bossBulletBlue())\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, dist: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        let a = r.sprite\n        if (canTrack) {\n            let desired = 55, radial = (dist - desired) * 0.9, side = (r.stateA % 2 == 0 ? 1 : -1) * 42\n            MinionBehaviorShared.setVel(a, nx * radial - ny * side, ny * radial + nx * side, 58 * speed)\n        } else MinionBehaviorShared.wander(r, 24 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(a, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 780 : 1050, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionWalkerBehavior {\n    function fire(a: Sprite, elite: boolean) {\n        let player = PlayerSystem.getPlayer(); if (player == null) return\n        let lead = elite ? 0.42 : 0.30\n        let tx = player.x + player.vx * lead, ty = player.y + player.vy * lead\n        let dx = tx - a.x, dy = ty - a.y, d = Math.sqrt(dx * dx + dy * dy); if (d < 1) d = 1\n        let speed = elite ? 48 : 42\n        MinionBehaviorShared.fireBullet(a.x, a.y, dx / d * speed, dy / d * speed, GameAssets.minionWalkerSlug())\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) MinionBehaviorShared.moveCurvedPursuit(r, nx, ny, (r.elite ? 19 : 13) * speed, (r.elite ? 7 : 5) * speed, 0.17)\n        else MinionBehaviorShared.wander(r, 12 * speed)\n        if (r.elite && canAttack && now >= r.nextAttackAt) { fire(r.sprite, true); r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(1450, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionSlimeBehavior {\n    export function maxGenerationForDifficulty(difficulty: number): number { return GameConfig.MINION_SLIME_MAX_SPLIT_GENERATION }\n    export function splitChildCount(difficulty: number, generation: number, elite: boolean): number {\n        let d = Math.max(1, Math.min(30, difficulty))\n        let count = GameConfig.MINION_SLIME_SPLIT_CHILD_BASE + Math.idiv(d - 1, GameConfig.MINION_SLIME_SPLIT_CHILD_STAGE_STEP)\n        if (elite && generation == 0) count += 1\n        let generationCap = GameConfig.MINION_SLIME_SPLIT_CHILD_MAX\n        if (generation >= 1) generationCap = 2\n        if (count > generationCap) count = generationCap\n        if (count < 2) count = 2\n        return count\n    }\n    export function generationSpeedScale(generation: number): number {\n        if (generation <= 0) return 1\n        if (generation == 1) return GameConfig.MINION_SLIME_GEN1_SPEED_PERCENT / 100\n        if (generation == 2) return GameConfig.MINION_SLIME_GEN2_SPEED_PERCENT / 100\n        return GameConfig.MINION_SLIME_GEN3_SPEED_PERCENT / 100\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, speedScale: number, difficulty: number, waveTier: number, now: number) {\n        let a = r.sprite, generationScale = generationSpeedScale(r.splitGeneration)\n        let phase = r.stateB\n        if (phase == 10) {\n            MinionBehaviorShared.steerVelocity(a, 0, 0, 0.55)\n            if (now < r.nextAttackAt) return\n            let pounceSpeed = EnemyFramework.scaleStage30(GameConfig.MINION_SLIME_POUNCE_SPEED_STAGE1, GameConfig.MINION_SLIME_POUNCE_SPEED_STAGE30, difficulty)\n            pounceSpeed *= r.elite ? 1.12 : 1.0\n            pounceSpeed *= 1 + Math.min(6, waveTier) * 0.025\n            pounceSpeed *= generationScale\n            r.burstVX = nx * pounceSpeed; r.burstVY = ny * pounceSpeed\n            r.stateB = 11; r.nextAttackAt = now + GameConfig.MINION_SLIME_POUNCE_DURATION_MS\n            SoundSystem.minionSlimePounce(); return\n        }\n        if (phase == 11) {\n            MinionBehaviorShared.steerVelocity(a, r.burstVX, r.burstVY, 0.72)\n            if (now >= r.nextAttackAt) {\n                r.stateB = 0; r.burstVX = 0; r.burstVY = 0\n                let pounceCooldown = randint(GameConfig.MINION_SLIME_POUNCE_COOLDOWN_MIN_MS, GameConfig.MINION_SLIME_POUNCE_COOLDOWN_MAX_MS)\n                r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, pounceCooldown)\n            }\n            return\n        }\n        MinionBehaviorShared.moveCurvedPursuit(r, nx, ny, 16 * speedScale * generationScale, 5 * speedScale * generationScale, 0.18)\n        if (now >= r.nextAttackAt) { r.stateB = 10; r.nextAttackAt = now + GameConfig.MINION_SLIME_POUNCE_PAUSE_MS; MinionBehaviorShared.steerVelocity(a, 0, 0, 0.72) }\n    }\n}\nnamespace MinionEyeBehavior {\n    function fire(a: Sprite, elite: boolean) {\n        let player = PlayerSystem.getPlayer(); if (player == null) return\n        let dx = player.x - a.x, dy = player.y - a.y, d = Math.sqrt(dx * dx + dy * dy); if (d < 1) d = 1\n        let speed = elite ? 82 : 70\n        MinionBehaviorShared.fireBullet(a.x, a.y, dx / d * speed, dy / d * speed, elite ? GameAssets.bossBulletAimedHard() : GameAssets.bossBulletAimed())\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, dist: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) MinionBehaviorShared.keepDistance(r.sprite, nx, ny, dist, 76, 26 * speed)\n        else MinionBehaviorShared.wander(r, 14 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite); r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 1000 : 1350, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionMothBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let dx = a.vx, dy = a.vy, d = Math.sqrt(dx * dx + dy * dy)\n        let base = d >= 1 ? Math.atan2(dy, dx) : (phase * 0.73)\n        let count = elite ? 6 : 4, speed = elite ? 48 : 43\n        for (let i = 0; i < count; i++) {\n            let wingIndex = Math.idiv(i, 2), side = i % 2 == 0 ? -1 : 1\n            let deg = elite ? (18 + wingIndex * 21) : (24 + wingIndex * 30)\n            let angle = base + side * deg * Math.PI / 180\n            MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(angle) * speed, Math.sin(angle) * speed, GameAssets.bossBulletSweep())\n        }\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, dist: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) { let side = (r.stateA % 2 == 0 ? 1 : -1); MinionBehaviorShared.setVel(r.sprite, -ny * 45 * side + nx * (dist - 70) * 0.35, nx * 45 * side + ny * (dist - 70) * 0.35, 52 * speed) }\n        else MinionBehaviorShared.wander(r, 22 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 900 : 1250, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionBeetleBehavior {\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, waveTier: number, attackDifficulty: number, now: number) {\n        if (now >= r.nextAttackAt) {\n            MinionBehaviorShared.steerVelocity(r.sprite, nx * (r.elite ? 95 : 78), ny * (r.elite ? 95 : 78), 0.34)\n            r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 900 : 1250, waveTier, attackDifficulty))\n        }\n    }\n}\nnamespace MinionJellyBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let angle = phase * 0.62, speed = elite ? 39 : 34\n        MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(angle) * speed, Math.sin(angle) * speed, GameAssets.bossBulletSpiral())\n        if (elite) { let opposite = angle + Math.PI; MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(opposite) * speed, Math.sin(opposite) * speed, GameAssets.bossBulletSpiralHard()) }\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, speed: number, canAttack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        MinionBehaviorShared.setVel(r.sprite, Math.cos((now + r.stateA * 10) / 700) * 18, Math.sin((now + r.stateA * 10) / 900) * 18, 25 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 1200 : 1600, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionSpiderBehavior {\n    function fire(a: Sprite, elite: boolean) {\n        let dl = a.x, dr = GameConfig.WORLD_WIDTH - a.x, dt = a.y, db = GameConfig.WORLD_HEIGHT - a.y\n        let nx = 1, ny = 0, nearest = dl\n        if (dr < nearest) { nearest = dr; nx = -1; ny = 0 }\n        if (dt < nearest) { nearest = dt; nx = 0; ny = 1 }\n        if (db < nearest) { nx = 0; ny = -1 }\n        let px = -ny, py = nx, count = elite ? 6 : 4, spacing = elite ? 5 : 6, speed = elite ? 48 : 42\n        for (let i = 0; i < count; i++) {\n            let lateral = (i - (count - 1) / 2) * spacing\n            MinionBehaviorShared.fireBullet(a.x + px * lateral, a.y + py * lateral, nx * speed, ny * speed, elite ? GameAssets.bossBulletArcHard() : GameAssets.bossBulletArc())\n        }\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, player: Sprite, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) MinionBehaviorShared.moveAlongNearestEdge(r.sprite, player, r.elite ? 36 : 27)\n        else MinionBehaviorShared.wander(r, 18 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite); r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 900 : 1250, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionCrabBehavior {\n    function fire(a: Sprite, elite: boolean) {\n        let rows = elite ? 2 : 1\n        for (let row = 0; row < rows; row++) {\n            let yOffset = (row - (rows - 1) / 2) * 10, speed = elite ? 58 : 52\n            MinionBehaviorShared.fireBullet(a.x, a.y + yOffset, -speed, 0, GameAssets.bossBulletRed())\n            MinionBehaviorShared.fireBullet(a.x, a.y + yOffset, speed, 0, GameAssets.bossBulletRed())\n        }\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, player: Sprite, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        let crabY = canTrack ? Math.max(-20, Math.min(20, (player.y - r.sprite.y) * 0.3)) : 0\n        MinionBehaviorShared.steerVelocity(r.sprite, (r.stateA % 2 == 0 ? 1 : -1) * (r.elite ? 42 : 31), crabY, 0.20)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 850 : 1200, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionBomberBehavior {\n    function fire(a: Sprite, elite: boolean) {\n        let mine = sprites.create(GameAssets.bossMine(), SpriteKind.BossBullet)\n        mine.z = GameConfig.BOSS_BULLET_Z; mine.setFlag(SpriteFlag.AutoDestroy, false); mine.setPosition(a.x, a.y); mine.vx = 0; mine.vy = 0; mine.lifespan = elite ? 1800 : 1400\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, dist: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) MinionBehaviorShared.moveCurvedPursuit(r, nx, ny, 20 * speed, (r.elite ? 19 : 15) * speed, 0.15)\n        else MinionBehaviorShared.wander(r, 13 * speed)\n        if (dist < 46 && canAttack && now >= r.nextAttackAt) {\n            fire(r.sprite, r.elite)\n            let recoil = r.elite ? 62 : 54\n            MinionBehaviorShared.steerVelocity(r.sprite, -nx * recoil, -ny * recoil, 1.0)\n            r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(1700, waveTier, attackDifficulty))\n        }\n    }\n}\nnamespace MinionWispBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let dx = a.vx, dy = a.vy, d = Math.sqrt(dx * dx + dy * dy)\n        if (d < 1) { let angle = (phase % 8) * Math.PI / 4; dx = Math.cos(angle); dy = Math.sin(angle); d = 1 }\n        let speed = elite ? 28 : 23\n        MinionBehaviorShared.fireBullet(a.x, a.y, dx / d * speed, dy / d * speed, GameAssets.minionWispLargeOrb())\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) { let side = (r.stateA % 2 == 0 ? 1 : -1); MinionBehaviorShared.setVel(r.sprite, nx * 12 - ny * 24 * side, ny * 12 + nx * 24 * side, 32 * speed) }\n        else MinionBehaviorShared.wander(r, 17 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 1200 : 1700, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionMaskBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let base = phase % 2 == 0 ? Math.PI / 4 : -Math.PI / 4, speed = elite ? 48 : 42\n        MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(base) * speed, Math.sin(base) * speed, GameAssets.bossBulletCross())\n        MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(base + Math.PI) * speed, Math.sin(base + Math.PI) * speed, GameAssets.bossBulletCross())\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, nx: number, ny: number, dist: number, speed: number, canAttack: boolean, canTrack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        if (canTrack) MinionBehaviorShared.keepDistance(r.sprite, nx, ny, dist, 68, 23 * speed)\n        else MinionBehaviorShared.wander(r, 14 * speed)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 900 : 1300, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionFlowerBehavior {\n    function fire(a: Sprite, elite: boolean, phase: number) {\n        let count = elite ? 10 : 6, speed = elite ? 40 : 36, offset = phase * 0.31\n        for (let i = 0; i < count; i++) {\n            let angle = offset + i * Math.PI * 2 / count\n            MinionBehaviorShared.fireBullet(a.x, a.y, Math.cos(angle) * speed, Math.sin(angle) * speed, elite ? GameAssets.bossBulletPetalHard() : GameAssets.bossBulletPetal())\n        }\n    }\n    export function update(r: MinionRuntimeSystem.MinionRuntime, canAttack: boolean, waveTier: number, attackDifficulty: number, now: number) {\n        MinionBehaviorShared.steerVelocity(r.sprite, Math.cos((now + r.stateA * 13) / 900) * 10, Math.sin((now + r.stateA * 17) / 900) * 10, 0.16)\n        if (canAttack && now >= r.nextAttackAt) { fire(r.sprite, r.elite, r.stateA); r.stateA += 1; r.nextAttackAt = MinionBehaviorShared.scheduleNextAttack(r, now, MinionBehaviorShared.scaledAttackCooldown(r.elite ? 1150 : 1550, waveTier, attackDifficulty)) }\n    }\n}\nnamespace MinionMedicBehavior {\n    export function update(r: MinionRuntimeSystem.MinionRuntime, now: number) {\n        let a = r.sprite, best: MinionRuntimeSystem.MinionRuntime = null, bestD = 999999\n        for (let i = 0; i < MinionRuntimeSystem.count(); i++) {\n            let other = MinionRuntimeSystem.get(i)\n            if (other == null || other == r || other.sprite == null || other.hp <= 0 || other.hp >= other.maxHP) continue\n            let dx = other.sprite.x - a.x, dy = other.sprite.y - a.y, d = dx * dx + dy * dy\n            if (d < bestD) { bestD = d; best = other }\n        }\n        if (best == null) { a.vx = 0; a.vy = 0; return }\n        let target = best.sprite, dx = target.x - a.x, dy = target.y - a.y, d = Math.sqrt(dx * dx + dy * dy); if (d < 1) d = 1\n        if (d > 28) MinionBehaviorShared.steerVelocity(a, dx / d * (r.elite ? 34 : 26), dy / d * (r.elite ? 34 : 26), 0.18)\n        else {\n            MinionBehaviorShared.steerVelocity(a, 0, 0, 0.22)\n            if (now >= r.nextAttackAt) {\n                best.hp = Math.min(best.maxHP, best.hp + (r.elite ? 2 : 1)); target.startEffect(effects.ashes, 80)\n                let healCooldown = r.elite ? 700 : 1000\n                if (r.hardSummoned) healCooldown = Math.idiv(healCooldown * GameConfig.SUMMONER_HARD_ATTACK_INTERVAL_PERCENT, 100)\n                r.nextAttackAt = now + healCooldown\n            }\n        }\n    }\n}\nnamespace MinionBehaviorSystem {\n    export function update(r: MinionRuntimeSystem.MinionRuntime, player: Sprite, now: number) {\n        if (r == null || r.sprite == null || r.hp <= 0 || player == null) return\n        let a = r.sprite\n        let dx = player.x - a.x, dy = player.y - a.y, dist = Math.sqrt(dx * dx + dy * dy); if (dist < 1) dist = 1\n        let nx = dx / dist, ny = dy / dist\n        let waveTier = r.spawnWaveTier; if (waveTier < 0) waveTier = 0\n        let difficultyLevel = r.difficultyLevel; if (difficultyLevel < 1) difficultyLevel = 1\n        let attackDifficulty = r.summoned ? difficultyLevel : StageSystem.getLevel()\n        let moveBoost = 1 + Math.min(6, waveTier) * 0.06\n        let stageMovePercent = EnemyFramework.scaleStage30(GameConfig.MINION_STAGE_MOVE_PERCENT_START, GameConfig.MINION_STAGE_MOVE_PERCENT_END, difficultyLevel)\n        let speed = (r.elite ? 1.16 : 1.0) * moveBoost * stageMovePercent / 100\n        let canAttack = !MinionCatalog.requiresPlayerAttackRange(r.type) || dist <= MinionCatalog.visionRange(r.type, r.elite)\n        let canTrack = !MinionCatalog.requiresPlayerMovementRange(r.type, r.elite) || dist <= MinionCatalog.visionRange(r.type, r.elite)\n        MinionBehaviorShared.nudgeBackFromWorldEdge(a, Math.max(20, 34 * speed))\n        if (MinionBehaviorShared.updateHitResponse(r, speed)) return\n        if (r.type == MinionCatalog.GHOST) MinionGhostBehavior.update(r, nx, ny, speed)\n        else if (r.type == MinionCatalog.BAT) MinionBatBehavior.update(r, nx, ny, dist, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.WALKER) MinionWalkerBehavior.update(r, nx, ny, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.SLIME) MinionSlimeBehavior.update(r, nx, ny, speed, difficultyLevel, waveTier, now)\n        else if (r.type == MinionCatalog.EYE) MinionEyeBehavior.update(r, nx, ny, dist, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.MOTH) MinionMothBehavior.update(r, nx, ny, dist, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.BEETLE) MinionBeetleBehavior.update(r, nx, ny, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.JELLY) MinionJellyBehavior.update(r, speed, canAttack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.SPIDER) MinionSpiderBehavior.update(r, player, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.CRAB) MinionCrabBehavior.update(r, player, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.BOMBER) MinionBomberBehavior.update(r, nx, ny, dist, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.WISP) MinionWispBehavior.update(r, nx, ny, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.MASK) MinionMaskBehavior.update(r, nx, ny, dist, speed, canAttack, canTrack, waveTier, attackDifficulty, now)\n        else if (r.type == MinionCatalog.FLOWER) MinionFlowerBehavior.update(r, canAttack, wave