owner.x) / dx\n            else if (dx < -0.001) tx = (0 - owner.x) / dx\n            if (dy > 0.001) ty = (GameConfig.WORLD_HEIGHT - owner.y) / dy\n            else if (dy < -0.001) ty = (0 - owner.y) / dy\n            distance = Math.min(tx, ty)\n        } else {\n            let actualSpeed = rushChargeSpeedForDifficulty()\n            let safeMs = getRushNormalSafeDurationMs(actualSpeed)\n            distance = actualSpeed * safeMs / 1000\n        }\n        if (distance < 1) return\n        let life = special ? GameConfig.BOSS_RUSH_SPECIAL_TELEGRAPH_MS : GameConfig.BOSS_RUSH_TELEGRAPH_MS\n        let halfWidth = Math.max(5, Math.idiv(Math.max(owner.width, owner.height) + 1, 2))\n        RushWarningOverlay.addRoute(owner.x, owner.y, owner.x + dx * distance, owner.y + dy * distance, halfWidth, special, game.runtime() + life)\n        SoundSystem.hardPatternWarning()\n    }\n    export function startRushSpecial(hard?: boolean) {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.sprite == null) return\n        let now = game.runtime(), player = PlayerSystem.getPlayer(); if (player == null) return\n        if (BossRushSpecial.isActive(rt.sprite) || BossRushSpecial.isRecovering(rt.sprite, now)) return\n        cancelRushNormalChargeForSpecial()\n        if (!BossRushSpecial.begin(rt.sprite, player, signatureDifficulty(hard == true), now, hard == true)) return\n        rt.rushTargetVX = BossRushSpecial.getDirectionX(rt.sprite); rt.rushTargetVY = BossRushSpecial.getDirectionY(rt.sprite)\n        rt.sprite.vx = 0; rt.sprite.vy = 0\n        showRushRouteWarning(true)\n        showSpecialCharge(rt.sprite, GameConfig.BOSS_RUSH_SPECIAL_TELEGRAPH_MS)\n    }\n    export function getRushNormalSafeDurationMs(actualSpeed: number): number {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.sprite == null || actualSpeed <= 0) return GameConfig.BOSS_RUSH_CHARGE_DURATION_MS\n        let owner = rt.sprite\n        let halfW = Math.idiv(owner.width + 1, 2), halfH = Math.idiv(owner.height + 1, 2)\n        let orbitInset = BossHybridSpecial.countForOwner(owner) > 0 ? GameConfig.HYBRID_CORE_ORBIT_RADIUS + 4 : 0\n        let minX = GameConfig.BOSS_WORLD_EDGE_MARGIN + halfW + 8 + orbitInset\n        let maxX = GameConfig.WORLD_WIDTH - GameConfig.BOSS_WORLD_EDGE_MARGIN - halfW - 8 - orbitInset\n        let minY = GameConfig.BOSS_WORLD_EDGE_MARGIN + halfH + 8 + orbitInset\n        let maxY = GameConfig.WORLD_HEIGHT - GameConfig.BOSS_WORLD_EDGE_MARGIN - halfH - 8 - orbitInset\n        let allowed = 999999\n        if (rt.rushTargetVX > 0.001) allowed = Math.min(allowed, (maxX - owner.x) / rt.rushTargetVX)\n        else if (rt.rushTargetVX < -0.001) allowed = Math.min(allowed, (minX - owner.x) / rt.rushTargetVX)\n        if (rt.rushTargetVY > 0.001) allowed = Math.min(allowed, (maxY - owner.y) / rt.rushTargetVY)\n        else if (rt.rushTargetVY < -0.001) allowed = Math.min(allowed, (minY - owner.y) / rt.rushTargetVY)\n        if (allowed < 0) allowed = 0\n        let safeMs = Math.idiv(Math.floor(allowed) * 1000, Math.max(1, Math.floor(actualSpeed)))\n        if (safeMs < 0) safeMs = 0\n        if (safeMs > GameConfig.BOSS_RUSH_CHARGE_DURATION_MS) safeMs = GameConfig.BOSS_RUSH_CHARGE_DURATION_MS\n        return safeMs\n    }\n    export function rushChargeSpeedForDifficulty(): number {\n        let difficulty = getPatternDifficultyLevel()\n        let rushChargeSpeed = EnemyFramework.scaleStage30(GameConfig.BOSS_RUSH_CHARGE_SPEED_STAGE1, GameConfig.BOSS_RUSH_CHARGE_SPEED_STAGE30, difficulty)\n        let speedStage = EnemyFramework.clampStage30(difficulty)\n        if (speedStage > GameConfig.BOSS_RUSH_SPEED_REDUCTION_START_STAGE) {\n            let speedScale = 100 - (speedStage - GameConfig.BOSS_RUSH_SPEED_REDUCTION_START_STAGE) * (100 - GameConfig.BOSS_RUSH_SPEED_SCALE_STAGE30_PERCENT) / (30 - GameConfig.BOSS_RUSH_SPEED_REDUCTION_START_STAGE)\n            rushChargeSpeed = rushChargeSpeed * speedScale / 100\n        }\n        return rushChargeSpeed\n    }\n    export function cancelRushNormalChargeForSpecial() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.rushTelegraphEndsAt = 0; rt.rushChargeEndsAt = 0; rt.rushNormalRecoveryEnd = 0\n        if (rt.sprite != null) { rt.sprite.vx = 0; rt.sprite.vy = 0 }\n    }\n}\nnamespace BossSystem {\n    export function resetPatternScheduler() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.resetAttackPlan()\n    }\n    export function clearActivePatterns() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.clearActivePatterns()\n    }\n    function indexOfNumber(arr: number[], value: number): number { for (let i = 0; i < arr.length; i++)if (arr[i] == value) return i; return -1 }\n    function takeRandomPattern(pool: number[]): number {\n        let randomIndex = randint(0, pool.length - 1), patternId = pool[randomIndex]\n        pool[randomIndex] = pool[pool.length - 1]; pool.pop(); return patternId\n    }\n    function appendSelectedMainPattern(patternId: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.selectedPatterns.push(patternId)\n        rt.selectedPatternInterferenceIds.push(InterferencePatternLibrary.pickForBoss(rt.type, scaledDifficultyStage(), getPatternDifficultyLevel()))\n    }\n    function appendWeightedUnique(pool: number[], weights: number[], wanted: number) {\n        let used: number[] = []\n        while (used.length < wanted) {\n            let total = 0\n            for (let i = 0; i < pool.length; i++)if (indexOfNumber(used, pool[i]) < 0) total += weights[i]\n            if (total <= 0) break\n            let roll = randint(1, total), chosen = -1\n            for (let i = 0; i < pool.length; i++) {\n                if (indexOfNumber(used, pool[i]) >= 0) continue\n                roll -= weights[i]\n                if (roll <= 0) { chosen = pool[i]; break }\n            }\n            if (chosen < 0) break\n            used.push(chosen); appendSelectedMainPattern(chosen)\n        }\n    }\n    function buildCategorizedMainSelection(type: number, pool: number[], wanted: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        let requiredCategory = BossAttackProfile.requiredMainCategory(type)\n        let requiredCount = BossAttackProfile.requiredMainCategoryCount(type)\n        let requiredPool: number[] = [], otherPools: number[][] = []\n        let categoryIds: number[] = []\n        for (let patternId of pool) {\n            let category = MainPatternLibrary.category(patternId)\n            if (category == requiredCategory) requiredPool.push(patternId)\n            else {\n                let slot = -1\n                for (let i = 0; i < categoryIds.length; i++)if (categoryIds[i] == category) { slot = i; break }\n                if (slot < 0) { categoryIds.push(category); otherPools.push([]); slot = otherPools.length - 1 }\n                otherPools[slot].push(patternId)\n            }\n        }\n        let guaranteed = Math.min(wanted, Math.min(requiredCount, requiredPool.length))\n        for (let i = 0; i < guaranteed; i++)appendSelectedMainPattern(takeRandomPattern(requiredPool))\n        if (requiredPool.length > 0) { categoryIds.push(requiredCategory); otherPools.push(requiredPool) }\n        while (rt.selectedPatterns.length < wanted) {\n            let totalCategoryWeight = 0, available: number[] = []\n            for (let i = 0; i < otherPools.length; i++)if (otherPools[i].length > 0) {\n                available.push(i)\n                totalCategoryWeight += BossAttackProfile.categoryWeight(type, categoryIds[i])\n            }\n            if (available.length <= 0) break\n            let chosenSlot = available[0]\n            if (available.length > 1 && totalCategoryWeight > 0) {\n                let roll = randint(1, totalCategoryWeight)\n                for (let slot of available) {\n                    roll -= BossAttackProfile.categoryWeight(type, categoryIds[slot])\n                    if (roll <= 0) { chosenSlot = slot; break }\n                }\n            }\n            appendSelectedMainPattern(takeRandomPattern(otherPools[chosenSlot]))\n        }\n    }\n    function maybeBorrowWallEdgePattern() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        if (!BossAttackProfile.canBorrowWallEdgePattern(rt.type)) return\n        if (rt.selectedPatterns.length <= 0 || randint(1, 100) > GameConfig.BOSS_OTHER_WALL_PATTERN_CHANCE_PERCENT) return\n        let wallPool: number[] = [15, 19, 23, 26, 27, 28], candidates: number[] = []\n        for (let p of wallPool) if (indexOfNumber(rt.selectedPatterns, p) < 0) candidates.push(p)\n        if (candidates.length <= 0) return\n        let protectedPrefix = BossAttackProfile.protectedMainPrefix(rt.type)\n        let replaceIndex = randint(0, rt.selectedPatterns.length - 1)\n        if (protectedPrefix > 0 && rt.selectedPatterns.length > protectedPrefix) replaceIndex = randint(protectedPrefix, rt.selectedPatterns.length - 1)\n        rt.selectedPatterns[replaceIndex] = candidates[randint(0, candidates.length - 1)]\n        rt.selectedPatternInterferenceIds[replaceIndex] = InterferencePatternLibrary.pickForBoss(rt.type, scaledDifficultyStage(), getPatternDifficultyLevel())\n    }\n    export function buildStagePatternCombo() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.clearActivePatterns()\n        rt.selectedPatterns = []; rt.selectedPatternInterferenceIds = []; rt.patternWeights = []; rt.nextPatternIndex = 0\n        let stageLevel = scaledDifficultyStage(), selectionCount = GameConfig.BOSS_COMBO_BASE_PATTERN_COUNT\n        if (stageLevel >= GameConfig.BOSS_COMBO_EXTRA_PATTERN_START_STAGE) selectionCount += 1 + Math.idiv(stageLevel - GameConfig.BOSS_COMBO_EXTRA_PATTERN_START_STAGE, GameConfig.BOSS_COMBO_STAGES_PER_EXTRA_PATTERN)\n        let pool = BossAttackProfile.mainPool(rt.type)\n        let wanted = BossAttackProfile.selectionCount(rt.type, selectionCount)\n        if (wanted > pool.length) wanted = pool.length\n        if (BossAttackProfile.requiredMainCategory(rt.type) >= 0) buildCategorizedMainSelection(rt.type, pool, wanted)\n        else if (BossAttackProfile.usesWeightedMainSelection(rt.type)) appendWeightedUnique(pool, BossAttackProfile.mainWeights(rt.type), wanted)\n        else for (let i = 0; i < wanted; i++)appendSelectedMainPattern(takeRandomPattern(pool))\n        maybeBorrowWallEdgePattern()\n        let signature = BossPatternLibrary.patternForBoss(rt.type)\n        if (signature >= 0 && indexOfNumber(rt.selectedPatterns, signature) < 0) { rt.selectedPatterns.push(signature); rt.selectedPatternInterferenceIds.push(-1) }\n        for (let i = 0; i < rt.selectedPatterns.length; i++)rt.patternWeights.push(getPatternTailWeightMax(rt.selectedPatterns[i]))\n        rt.restDueAt = 0; rt.restUntilAt = 0; rt.restPending = false\n        rt.nextPatternAt = game.runtime() + GameConfig.BOSS_FIRST_PATTERN_DELAY_MS\n    }\n}\nnamespace BossSystem {\n    export function isExclusivePatternForBoss(type: number, patternId: number): boolean { return BossPatternLibrary.isBossPattern(type, patternId) }\n    export function getPatternTailWeightMax(patternId: number): number { return GameConfig.BOSS_TAIL_WEIGHT_MAX }\n    export function getPatternTailRecovery(patternId: number): number {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return GameConfig.BOSS_TAIL_WEIGHT_RECOVERY\n        if (isExclusivePatternForBoss(rt.type, patternId)) {\n            let level = getPatternDifficultyLevel(); if (level < 1) level = 1; if (level > 30) level = 30\n            return GameConfig.BOSS_SPECIAL_TAIL_RECOVERY_LOW - Math.idiv((level - 1) * (GameConfig.BOSS_SPECIAL_TAIL_RECOVERY_LOW - GameConfig.BOSS_SPECIAL_TAIL_RECOVERY_HIGH), 29)\n        }\n        return GameConfig.BOSS_TAIL_WEIGHT_RECOVERY\n    }\n    export function hasActivePatternId(patternId: number): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return false\n        for (let id of rt.activePatternIds) if (id == patternId) return true\n        return false\n    }\n    export function getTailEffectiveWeight(patternId: number, baseWeight: number): number {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return 0\n        let weight = Math.max(0, baseWeight)\n        if (isExclusivePatternForBoss(rt.type, patternId)) {\n            let percent = BossPatternLibrary.selectionWeightPercent(rt.type, patternId)\n            if (percent <= 0) return 0\n            weight = Math.idiv(weight * percent, 100)\n            if (weight < 1 && baseWeight > 0) weight = 1\n        }\n        let index = BossRuntimeSystem.currentIndex()\n        if (isExclusivePatternForBoss(rt.type, patternId) && index >= 0 && isEnemyEnraged(index)) {\n            weight = Math.idiv(weight * GameConfig.BOSS_ENRAGE_SPECIAL_WEIGHT_PERCENT, 100)\n            if (weight < 1 && baseWeight > 0) weight = 1\n        }\n        return weight\n    }\n    export function canTailSelectPattern(patternId: number, now: number): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return false\n        if (isExclusivePatternForBoss(rt.type, patternId)) return BossPatternLibrary.canSelect(rt.type, patternId, now)\n        return true\n    }\n    export function chooseTailWeightedPatternIndex(now: number, blockedPatternId: number): number {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return -1\n        while (rt.patternWeights.length < rt.selectedPatterns.length) rt.patternWeights.push(getPatternTailWeightMax(rt.selectedPatterns[rt.patternWeights.length]))\n        let total = 0\n        for (let i = 0; i < rt.selectedPatterns.length; i++) {\n            let id = rt.selectedPatterns[i]; if (id == blockedPatternId || !canTailSelectPattern(id, now)) continue\n            total += getTailEffectiveWeight(id, rt.patternWeights[i])\n        }\n        if (total <= 0) {\n            let fallback: number[] = []\n            for (let i = 0; i < rt.selectedPatterns.length; i++)if (rt.selectedPatterns[i] != blockedPatternId && canTailSelectPattern(rt.selectedPatterns[i], now)) fallback.push(i)\n            if (fallback.length <= 0) return -1\n            return fallback[randint(0, fallback.length - 1)]\n        }\n        let roll = randint(1, total)\n        for (let i = 0; i < rt.selectedPatterns.length; i++) {\n            let id = rt.selectedPatterns[i]; if (id == blockedPatternId || !canTailSelectPattern(id, now)) continue\n            roll -= getTailEffectiveWeight(id, rt.patternWeights[i]); if (roll <= 0) return i\n        }\n        return -1\n    }\n    export function commitPatternTailPick(chosenIndex: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        for (let i = 0; i < rt.patternWeights.length; i++) {\n            if (i == chosenIndex) { rt.patternWeights[i] = 0; continue }\n            rt.patternWeights[i] += getPatternTailRecovery(rt.selectedPatterns[i])\n            let maxWeight = getPatternTailWeightMax(rt.selectedPatterns[i]); if (rt.patternWeights[i] > maxWeight) rt.patternWeights[i] = maxWeight\n        }\n    }\n}\nnamespace BossSystem {\n    export function getPatternWindupMs(patternId: number): number { let rt = BossRuntimeSystem.current(); return rt == null ? 0 : BossPatternLibrary.windup(rt.type, patternId) }\n    export function isOneShotSignaturePattern(patternId: number): boolean { return BossPatternLibrary.isOneShot(patternId) }\n    export function getPatternRecoveryMs(patternId: number): number {\n        let special = BossPatternLibrary.recovery(patternId)\n        if (special >= 0) return special\n        return MainPatternLibrary.recovery(patternId)\n    }\n    export function getPatternDuration(patternId: number): number {\n        let special = BossPatternLibrary.duration(patternId)\n        if (special >= 0) return special\n        return MainPatternLibrary.duration(patternId)\n    }\n    export function getPatternInterval(patternId: number): number {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return 1\n        if (BossPatternLibrary.isBossPattern(rt.type, patternId) && !BossPatternLibrary.usesMainPatternTiming(patternId)) return 1\n        let interval = MainPatternLibrary.interval(patternId)\n        interval = Math.idiv(interval * BossAttackProfile.mainIntervalPercent(rt.type), 100)\n        interval = Math.idiv(interval * BossPatternLibrary.mainIntervalExtraPercent(rt.type), 100)\n        if (isDualBossStage()) interval = Math.idiv(interval * GameConfig.DUAL_BOSS_PATTERN_INTERVAL_PERCENT, 100)\n        let index = BossRuntimeSystem.currentIndex()\n        if (index >= 0 && isEnemyEnraged(index)) interval = Math.max(1, Math.idiv(interval * GameConfig.BOSS_ENRAGE_ATTACK_INTERVAL_PERCENT, 100))\n        return interval\n    }\n    export function estimatePatternVolleyCount(patternId: number): number {\n        let interval = getPatternInterval(patternId); if (interval < 1) interval = 1\n        let count = Math.idiv(getPatternDuration(patternId) + interval - 1, interval); if (count < 1) count = 1\n        return count\n    }\n    export function chooseSustainedHardVolleyCount(patternId: number): number {\n        let roll = randint(0, 2), wanted = GameConfig.BOSS_SUSTAINED_HARD_SHORT_VOLLEYS\n        if (roll == 1) wanted = GameConfig.BOSS_SUSTAINED_HARD_MEDIUM_VOLLEYS\n        else if (roll == 2) wanted = GameConfig.BOSS_SUSTAINED_HARD_LONG_VOLLEYS\n        let total = estimatePatternVolleyCount(patternId)\n        if (total > 1 && wanted >= total) wanted = total - 1\n        if (wanted < 1) wanted = 1\n        return wanted\n    }\n    export function rollHardMode(): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null || !BossAttackProfile.normalHardEnabled(rt.type)) return false\n        let level = getEffectiveDifficultyLevel()\n        let chance = GameConfig.BOSS_HARD_MODE_CHANCE_BASE_PERCENT +\n            Math.idiv((level - 1) * (GameConfig.BOSS_HARD_MODE_CHANCE_MAX_PERCENT - GameConfig.BOSS_HARD_MODE_CHANCE_BASE_PERCENT), GameConfig.BOSS_MAX_DIFFICULTY_LEVEL - 1)\n        if (isDualBossStage()) chance = Math.idiv(chance * GameConfig.DUAL_BOSS_HARD_CHANCE_PERCENT, 100)\n        return randint(1, 100) <= chance\n    }\n    export function isSignatureHardMode(): boolean { let i = BossRuntimeSystem.currentIndex(); return i >= 0 && isEnemyEnraged(i) }\n    export function signatureDifficulty(hard: boolean): number {\n        let d = getPatternDifficultyLevel(); if (d > GameConfig.BOSS_MAX_DIFFICULTY_LEVEL) d = GameConfig.BOSS_MAX_DIFFICULTY_LEVEL; if (d < 1) d = 1\n        return d\n    }\n}\nnamespace BossSystem {\n    export function tryStartSelectedPattern(patternId: number, interferenceId: number, now: number): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return false\n        if (BossPatternLibrary.isBossPattern(rt.type, patternId)) return BossPatternLibrary.tryStart(rt.type, patternId, interferenceId, now)\n        activatePatternInstance(patternId, interferenceId, now)\n        return true\n    }\n    export function emitPatternVolley(patternId: number, hard: boolean, volleyIndex: number, hardCue: boolean) {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.sprite == null || rt.hp <= 0) return\n        if (BossPatternLibrary.isBossPattern(rt.type, patternId)) {\n            BossPatternLibrary.emit(rt.type, patternId, hard, volleyIndex, hardCue)\n            return\n        }\n        if (hardCue) showHardAttackCue(rt.sprite)\n        SoundSystem.bossPatternFire(patternId, hard, hardCue)\n        patternOriginBoss = rt.sprite\n        specialEmissionActive = false\n        MainPatternLibrary.emit(patternId, hard, volleyIndex)\n        patternOriginBoss = null\n    }\n    export function emitInterferenceVolley(interferenceId: number, volleyIndex: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.sprite == null || rt.hp <= 0) return\n        SoundSystem.bossInterferenceFire(interferenceId)\n        patternOriginBoss = rt.sprite\n        InterferencePatternLibrary.emit(rt.type, interferenceId, volleyIndex)\n        patternOriginBoss = null\n    }\n}\nnamespace BossSystem {\n    export function isCurrentBossResting(now: number): boolean {\n        let rt = BossRuntimeSystem.current(); return rt != null && now < rt.restUntilAt\n    }\n    export function hasBlockingActivePattern(): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return false\n        let now = game.runtime()\n        if (BossPatternLibrary.hasBlockingState(rt.type, now)) return true\n        for (let i = 0; i < rt.activePatternIds.length; i++)if (BossPatternLibrary.activeEntryBlocksScheduler(rt.type, rt.activePatternIds[i], now)) return true\n        return false\n    }\n    export function canEnterBossRest(now: number): boolean {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.sprite == null || now < rt.nextPatternAt) return false\n        if (rt.activePatternIds.length > 0 || hasPendingEdgeMarkerForBoss(rt.sprite)) return false\n        return BossPatternLibrary.allowsRest(rt.type, now)\n    }\n    export function activatePatternInstance(patternId: number, interferenceId: number, now: number, skipCharge?: boolean, forcedSignatureHard?: boolean) {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        let special = isExclusivePatternForBoss(rt.type, patternId)\n        let signatureHard = special && (forcedSignatureHard == null ? isSignatureHardMode() : forcedSignatureHard)\n        let chargeMs = special && !skipCharge ? getPatternWindupMs(patternId) : 0\n        if (special && rt.sprite != null && chargeMs > 0) showSpecialCharge(rt.sprite, chargeMs)\n        let sustainedType = MainPatternLibrary.usesSustainedHard(patternId)\n        let burstHard = special ? signatureHard : (!sustainedType && rollHardMode())\n        let hardStartVolley = 999999, hardVolleyLimit = 0\n        if (special && BossPatternLibrary.usesSingleHardVolley(patternId) && signatureHard) {\n            hardStartVolley = 0; hardVolleyLimit = 1; burstHard = false\n        } else if (sustainedType && rollHardMode()) {\n            hardVolleyLimit = chooseSustainedHardVolleyCount(patternId)\n            let totalVolleys = estimatePatternVolleyCount(patternId), latestStart = totalVolleys - hardVolleyLimit\n            if (latestStart < 0) latestStart = 0\n            hardStartVolley = randint(0, Math.min(2, latestStart))\n        }\n        rt.activePatternIds.push(patternId)\n        let actualStart = now + chargeMs\n        rt.activePatternStarts.push(actualStart)\n        let activeDuration = (special && BossPatternLibrary.usesSingleHardVolley(patternId) && signatureHard) ? GameConfig.BOSS_SIGNATURE_EXECUTION_WINDOW_MS : getPatternDuration(patternId)\n        rt.activePatternEnds.push(actualStart + activeDuration)\n        rt.activePatternLastShots.push(actualStart - getPatternInterval(patternId))\n        rt.activePatternHardPending.push(burstHard)\n        rt.activePatternHardStartVolleys.push(hardStartVolley)\n        rt.activePatternHardVolleyLimits.push(hardVolleyLimit)\n        rt.activePatternVolleyCounts.push(0)\n        rt.activePatternInterferenceIds.push(interferenceId)\n        rt.activePatternInterferenceLastShots.push(now)\n        rt.activePatternInterferenceVolleyCounts.push(0)\n    }\n    export function startNextPattern(now: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null || rt.selectedPatterns.length <= 0) return\n        let blockedPatternId = -999\n        for (let attempt = 0; attempt < 3; attempt++) {\n            let chosenIndex = -1\n            if (rt.nextPatternIndex == 0) {\n                let signature = BossPatternLibrary.patternForBoss(rt.type)\n                for (let i = 0; i < rt.selectedPatterns.length; i++)if (rt.selectedPatterns[i] == signature && canTailSelectPattern(signature, now)) { chosenIndex = i; break }\n            }\n            if (chosenIndex < 0) chosenIndex = chooseTailWeightedPatternIndex(now, blockedPatternId)\n            if (chosenIndex < 0) return\n            let patternId = rt.selectedPatterns[chosenIndex], interferenceId = rt.selectedPatternInterferenceIds[chosenIndex]\n            if (!tryStartSelectedPattern(patternId, interferenceId, now)) { blockedPatternId = patternId; continue }\n            commitPatternTailPick(chosenIndex); rt.nextPatternIndex += 1; rt.lastScheduledPatternId = patternId\n            if (rt.nextPatternIndex == 1) { let firstDelay = BossPatternLibrary.firstPickDelayMs(patternId); if (firstDelay > 0) rt.nextPatternAt = now + firstDelay }\n            return\n        }\n    }\n    export function removeActivePattern(index: number) {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        rt.activePatternIds.removeAt(index); rt.activePatternStarts.removeAt(index); rt.activePatternEnds.removeAt(index); rt.activePatternLastShots.removeAt(index)\n        rt.activePatternHardPending.removeAt(index); rt.activePatternHardStartVolleys.removeAt(index); rt.activePatternHardVolleyLimits.removeAt(index); rt.activePatternVolleyCounts.removeAt(index)\n        rt.activePatternInterferenceIds.removeAt(index); rt.activePatternInterferenceLastShots.removeAt(index); rt.activePatternInterferenceVolleyCounts.removeAt(index)\n    }\n    export function updatePatternScheduler() {\n        let rt = BossRuntimeSystem.current(); if (rt == null) return\n        let now = game.runtime(), index = BossRuntimeSystem.currentIndex()\n        if (rt.restDueAt <= 0) rt.restDueAt = now + randint(GameConfig.BOSS_COMBAT_WINDOW_MIN_MS, GameConfig.BOSS_COMBAT_WINDOW_MAX_MS)\n        if (now >= rt.restDueAt && now >= rt.restUntilAt) rt.restPending = tr