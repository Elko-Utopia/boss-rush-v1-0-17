f (kind == BGM_BOSS_RUSH) {\n            music.play(rushBossBgm, music.PlaybackMode.LoopingInBackground)\n        } else if (kind == BGM_BOSS_SUMMONER) {\n            music.play(summonerBossBgm, music.PlaybackMode.LoopingInBackground)\n        } else if (kind == BGM_BOSS_DUAL) {\n            music.play(dualBossBgm, music.PlaybackMode.LoopingInBackground)\n        } else if (kind == BGM_BOSS_LASER) {\n            music.play(laserBossBgm, music.PlaybackMode.LoopingInBackground)\n        }\n        applyMasterVolume(BGM_FADE_START_VOLUME)\n        fadeInActive = true\n        fadeInStartAt = game.runtime()\n        fadeInEndAt = fadeInStartAt + BGM_FADE_IN_MS\n    }\n    function finishFadeOut() {\n        applyMasterVolume(0)\n        music.stopAllSounds()\n        currentBgm = BGM_NONE\n        fadeActive = false\n        fadeStartAt = 0\n        fadeEndAt = 0\n        let next = pendingBgm\n        pendingBgm = BGM_NONE\n        if (next != BGM_NONE) {\n            startBgmNow(next)\n        } else {\n            applyMasterVolume(MASTER_VOLUME)\n        }\n    }\n    function beginFadeOut(nextBgm: number) {\n        fadeScheduledAt = 0\n        if (currentBgm == BGM_NONE) {\n            if (nextBgm != BGM_NONE) startBgmNow(nextBgm)\n            return\n        }\n        if (fadeActive) {\n            pendingBgm = nextBgm\n            return\n        }\n        fadeInActive = false\n        pendingBgm = nextBgm\n        fadeActive = true\n        fadeStartAt = game.runtime()\n        let fadeDuration = fadeDurationOverrideMs > 0 ? fadeDurationOverrideMs : BGM_FADE_OUT_MS\n        fadeDurationOverrideMs = 0\n        fadeEndAt = fadeStartAt + fadeDuration\n        fadeStartVolume = currentMasterVolume\n        if (fadeStartVolume < BGM_FADE_MIN_VOLUME) fadeStartVolume = BGM_FADE_MIN_VOLUME\n    }\n    export function init() {\n        if (initialized) return\n        initialized = true\n        applyMasterVolume(MASTER_VOLUME)\n        GameUpdateScheduler.every(BGM_FADE_STEP_MS, function () {\n            let now = game.runtime()\n            if (fadeScheduledAt > 0 && now >= fadeScheduledAt) {\n                fadeScheduledAt = 0\n                beginFadeOut(BGM_NONE)\n            }\n            if (fadeActive) {\n                if (now >= fadeEndAt) {\n                    finishFadeOut()\n                    return\n                }\n                let duration = fadeEndAt - fadeStartAt\n                if (duration <= 0) {\n                    finishFadeOut()\n                    return\n                }\n                let elapsed = now - fadeStartAt\n                if (elapsed < 0) elapsed = 0\n                let progress1000 = Math.idiv(elapsed * 1000, duration)\n                if (progress1000 > 1000) progress1000 = 1000\n                let curved1000 = Math.idiv(progress1000 * progress1000, 1000)\n                let volume = Math.idiv(fadeStartVolume * (1000 - curved1000), 1000)\n                if (volume < BGM_FADE_MIN_VOLUME) volume = BGM_FADE_MIN_VOLUME\n                applyMasterVolume(volume)\n                return\n            }\n            if (fadeInActive) {\n                if (now >= fadeInEndAt) {\n                    fadeInActive = false\n                    applyMasterVolume(targetVolumeForBgm(currentBgm))\n                    return\n                }\n                let duration = fadeInEndAt - fadeInStartAt\n                if (duration <= 0) {\n                    fadeInActive = false\n                    applyMasterVolume(targetVolumeForBgm(currentBgm))\n                    return\n                }\n                let elapsed = now - fadeInStartAt\n                if (elapsed < 0) elapsed = 0\n                let progress1000 = Math.idiv(elapsed * 1000, duration)\n                if (progress1000 > 1000) progress1000 = 1000\n                let target = targetVolumeForBgm(currentBgm)\n                let volume = BGM_FADE_START_VOLUME + Math.idiv((target - BGM_FADE_START_VOLUME) * progress1000, 1000)\n                applyMasterVolume(volume)\n            }\n        })\n    }\n    export function playMinionBgm() {\n        fadeScheduledAt = 0\n        if (isMinionBgm(currentBgm) && !fadeActive) return\n        let next = chooseMinionBgm()\n        if (currentBgm == BGM_NONE) {\n            startBgmNow(next)\n        } else {\n            beginFadeOut(next)\n        }\n    }\n    export function scheduleMinionBgmStopAfterClear() {\n        if (!isMinionBgm(currentBgm)) return\n        fadeScheduledAt = game.runtime() + MINION_CLEAR_SFX_GRACE_MS\n    }\n    export function playBossBgm() {\n        fadeScheduledAt = 0\n        let next = selectBossBgm()\n        if (currentBgm == next && !fadeActive) return\n        if (currentBgm == BGM_NONE) {\n            startBgmNow(next)\n        } else {\n            beginFadeOut(next)\n        }\n    }\n    export function playTitleBgm() {\n        fadeScheduledAt = 0\n        let next = BGM_TITLE_HYBRID\n        if (currentBgm == next && !fadeActive) return\n        if (currentBgm == BGM_NONE) {\n            startBgmNow(next)\n        } else {\n            beginFadeOut(next)\n        }\n    }\n    export function stopForGameStart() {\n        fadeScheduledAt = 0\n        fadeDurationOverrideMs = GameConfig.GAME_ENTRY_TRANSITION_MS\n        if (currentBgm != BGM_NONE) beginFadeOut(BGM_NONE)\n        else fadeDurationOverrideMs = 0\n    }\n    export function stopForStageClear() {\n        fadeScheduledAt = 0\n        if (currentBgm != BGM_NONE) beginFadeOut(BGM_NONE)\n    }\n    export function compensateSfxVolume(baseVolume: number): number {\n        let volumeForMath = currentMasterVolume\n        if (volumeForMath < 16) volumeForMath = 16\n        let compensated = Math.idiv(baseVolume * 255, volumeForMath)\n        if (compensated > 1023) compensated = 1023\n        if (compensated < 0) compensated = 0\n        return compensated\n    }\n}\nnamespace SoundRuntime {\n    const IDENTICAL_SFX_MERGE_WINDOW_MS = 24\n    const IDENTICAL_SFX_CACHE_SIZE = 32\n    let recentWave: number[] = []\n    let recentStartFrequency: number[] = []\n    let recentEndFrequency: number[] = []\n    let recentStartVolume: number[] = []\n    let recentEndVolume: number[] = []\n    let recentDuration: number[] = []\n    let recentEffect: number[] = []\n    let recentCurve: number[] = []\n    let recentPlaybackMode: number[] = []\n    let recentAt: number[] = []\n    let recentWriteIndex = 0\n    function resolveVolume(sourceVolume: number): number {\n        let boostedVolume = sourceVolume\n        if (sourceVolume <= 35) {\n            boostedVolume = Math.idiv(sourceVolume * 500, 100)\n        } else if (sourceVolume <= 60) {\n            boostedVolume = Math.idiv(sourceVolume * 360, 100)\n        } else if (sourceVolume <= 90) {\n            boostedVolume = Math.idiv(sourceVolume * 280, 100)\n        } else {\n            boostedVolume = Math.idiv(sourceVolume * 220, 100)\n        }\n        if (boostedVolume > 1023) boostedVolume = 1023\n        return MusicSystem.compensateSfxVolume(boostedVolume)\n    }\n    function isIdenticalDuplicate(\n        wave: WaveShape,\n        startFrequency: number,\n        endFrequency: number,\n        finalStartVolume: number,\n        finalEndVolume: number,\n        durationMs: number,\n        effect: SoundExpressionEffect,\n        curve: InterpolationCurve,\n        playbackMode: music.PlaybackMode,\n        mergeWindowMs: number\n    ): boolean {\n        if (mergeWindowMs <= 0) return false\n        let now = game.runtime()\n        for (let i = 0; i < recentWave.length; i++) {\n            if (recentWave[i] == wave &&\n                recentStartFrequency[i] == startFrequency &&\n                recentEndFrequency[i] == endFrequency &&\n                recentStartVolume[i] == finalStartVolume &&\n                recentEndVolume[i] == finalEndVolume &&\n                recentDuration[i] == durationMs &&\n                recentEffect[i] == effect &&\n                recentCurve[i] == curve &&\n                recentPlaybackMode[i] == playbackMode) {\n                if (now - recentAt[i] < mergeWindowMs) return true\n                recentAt[i] = now\n                return false\n            }\n        }\n        if (recentWave.length < IDENTICAL_SFX_CACHE_SIZE) {\n            recentWave.push(wave)\n            recentStartFrequency.push(startFrequency)\n            recentEndFrequency.push(endFrequency)\n            recentStartVolume.push(finalStartVolume)\n            recentEndVolume.push(finalEndVolume)\n            recentDuration.push(durationMs)\n            recentEffect.push(effect)\n            recentCurve.push(curve)\n            recentPlaybackMode.push(playbackMode)\n            recentAt.push(now)\n        } else {\n            let i = recentWriteIndex\n            recentWave[i] = wave\n            recentStartFrequency[i] = startFrequency\n            recentEndFrequency[i] = endFrequency\n            recentStartVolume[i] = finalStartVolume\n            recentEndVolume[i] = finalEndVolume\n            recentDuration[i] = durationMs\n            recentEffect[i] = effect\n            recentCurve[i] = curve\n            recentPlaybackMode[i] = playbackMode\n            recentAt[i] = now\n            recentWriteIndex = (recentWriteIndex + 1) % IDENTICAL_SFX_CACHE_SIZE\n        }\n        return false\n    }\n    export function play(\n        wave: WaveShape,\n        startFrequency: number,\n        endFrequency: number,\n        startVolume: number,\n        durationMs: number\n    ) {\n        playCustom(\n            wave, startFrequency, endFrequency, startVolume, 0, durationMs,\n            SoundExpressionEffect.None, InterpolationCurve.Linear,\n            music.PlaybackMode.InBackground, IDENTICAL_SFX_MERGE_WINDOW_MS\n        )\n    }\n    export function playCustom(\n        wave: WaveShape,\n        startFrequency: number,\n        endFrequency: number,\n        startVolume: number,\n      