rentWaveOriginalCount = 0\n        stageTargetCount = getTargetCountForStage(StageSystem.getLevel())\n        stageSpawnedCount = 0; stageDefeatedCount = 0; stageStartedAt = 0\n        buildStageSpawnPlan()\n        waveNoticeUntil = 0\n        stageIntroStartedAt = game.runtime()\n        stageIntroUntil = stageIntroStartedAt + GameConfig.STAGE_INTRO_MS\n        if (warningHud != null) warningHud.setFlag(SpriteFlag.Invisible, true)\n        if (waveNoticeHud != null) waveNoticeHud.setFlag(SpriteFlag.Invisible, true)\n        if (stageIntroHud != null) { stageIntroHud.setFlag(SpriteFlag.Invisible, false); renderStageIntro(stageIntroStartedAt) }\n        PlayerSystem.resetStageDamageCount()\n        ScoreSystem.startStage()\n        GrazeSystem.startStage()\n        ShieldSystem.resetForStage()\n        WorldSystem.randomizeBackgroundForStage()\n        if (!gameEntryPrepared) SoundSystem.stageIntro()\n    }\n    export function startStageForGameEntry() {\n        gameEntryPrepared = true\n        startStage()\n    }\n    export function updateGameEntryPresentation() {\n        let now = game.runtime()\n        if (stageIntroActive) renderStageIntro(now)\n        if (warningActive) renderBossWarning(now)\n    }\n    export function finishGameEntryPresentation() {\n        let now = game.runtime()\n        if (stageIntroActive) {\n            renderStageIntro(now)\n            if (now >= stageIntroUntil) {\n                stageIntroActive = false\n                if (stageIntroHud != null) stageIntroHud.setFlag(SpriteFlag.Invisible, true)\n                stageStartedAt = now\n                spawnNextWave()\n            }\n        }\n        if (warningActive) {\n            renderBossWarning(now)\n            if (now >= warningUntil) {\n                warningActive = false\n                stageActive = false\n                if (warningHud != null) warningHud.setFlag(SpriteFlag.Invisible, true)\n                BossSystem.startBossPhase()\n            }\n        }\n        if (!GameSession.isBossOnlyMode()) MusicSystem.playMinionBgm()\n        gameEntryPrepared = false\n    }\n    export function isStageActive(): boolean { return stageActive }\n    export function isTransitionActive(): boolean { return stageIntroActive || preWarningActive || warningActive }\n    export function getStageTimeLimitMs(): number {\n        let limit = GameConfig.MINION_TIME_BASE_MS + stageTargetCount * GameConfig.MINION_TIME_PER_TARGET_MS\n        if (limit > GameConfig.MINION_TIME_MAX_MS) limit = GameConfig.MINION_TIME_MAX_MS\n        return limit\n    }\n    export function getStageElapsedMs(): number {\n        if (stageStartedAt <= 0) return 0\n        return game.runtime() - stageStartedAt\n    }\n    export function getStageCountdownMs(): number {\n        if (!stageActive) return 0\n        let remaining = getStageTimeLimitMs() - getStageElapsedMs()\n        return remaining > 0 ? remaining : 0\n    }\n    export function isEliteEnemy(enemy: Sprite): boolean { let r = MinionRuntimeSystem.get(MinionRuntimeSystem.indexOfSprite(enemy)); return r != null && r.elite }\n    export function getCombinedHP(): number { return Math.max(0, stageTargetCount - stageDefeatedCount) }\n    export function getCombinedMaxHP(): number { return Math.max(1, stageTargetCount) }\n    function chooseStageTypes(): number[] {\n        let wanted = randint(GameConfig.MINION_STAGE_MIN_TYPES, GameConfig.MINION_STAGE_MAX_TYPES)\n        let result: number[] = []\n        let bossCount = BossSystem.getPlannedBossCount()\n        for (let i = 0; i < bossCount; i++) {\n            let affinity = getAffinityForBoss(BossSystem.getPlannedBossType(i))\n            pushUnique(result, affinity)\n        }\n        while (result.length < wanted) {\n            let pick = weightedMinionPick(result)\n            if (pick < 0) break\n            pushUnique(result, pick)\n        }\n        return result\n    }\n    function getAffinityForBoss(type: number): number { return MinionCatalog.affinityForBoss(type) }\n    function weightedMinionPick(excluded: number[]): number {\n        let weighted: number[] = []\n        for (let t = 0; t < GameConfig.MINION_TYPE_COUNT; t++) {\n            if (indexOfNumber(excluded, t) >= 0) continue\n            let w = 2\n            for (let b = 0; b < BossSystem.getPlannedBossCount(); b++) {\n                let bt = BossSystem.getPlannedBossType(b)\n                if (getAffinityForBoss(bt) == t) w += 7\n                if (bt == 1 && (t == SPIDER || t == CRAB)) w += 3\n                if (bt == 2 && (t == EYE || t == WALKER)) w += 3\n                if (bt == 3 && (t == FLOWER || t == MOTH || t == JELLY)) w += 3\n                if (bt == 4 && (t == GHOST || t == BEETLE || t == BOMBER)) w += 3\n                if (bt == 5 && (t == SLIME || t == MEDIC || t == WISP)) w += 3\n            }\n            for (let n = 0; n < w; n++)weighted.push(t)\n        }\n        if (weighted.length <= 0) return -1\n        return weighted[randint(0, weighted.length - 1)]\n    }\n    function pushUnique(arr: number[], v: number) { if (indexOfNumber(arr, v) < 0) arr.push(v) }\n    function indexOfNumber(arr: number[], v: number): number { for (let i = 0; i < arr.length; i++)if (arr[i] == v) return i; return -1 }\n    function getTargetCountForStage(stage: number): number {\n        if (stage < 1) stage = 1\n        return GameConfig.MINION_TARGET_BASE_COUNT + Math.idiv((stage - 1) * GameConfig.MINION_TARGET_GROWTH_NUMERATOR, GameConfig.MINION_TARGET_GROWTH_DENOMINATOR)\n    }\n    function buildStageSpawnPlan() {\n        stagePlanTypes = []; stagePlanElites = []\n        let stage = StageSystem.getLevel()\n        for (let i = 0; i < stageTargetCount; i++) {\n            let type = selectedTypes[randint(0, selectedTypes.length - 1)]\n            let elite = rollElite(stage)\n            stagePlanTypes.push(type); stagePlanElites.push(elite)\n        }\n        HudSystem.updateBossHP()\n    }\n    function getWaveSizeForIndex(index: number): number {\n        let stage = StageSystem.getLevel()\n        if (stage < 1) stage = 1\n        let count = GameConfig.MINION_WAVE_BASE_COUNT + Math.idiv(stage - 1, GameConfig.MINION_WAVE_STAGES_PER_EXTRA)\n        if (count > GameConfig.MINION_WAVE_MAX_COUNT) count = GameConfig.MINION_WAVE_MAX_COUNT\n        return count\n    }\n    function spawnNextWave() {\n        if (!stageActive || warningActive || stageSpawnedCount >= stageTargetCount) return\n        let remaining = stageTargetCount - stageSpawnedCount\n        let count = getWaveSizeForIndex(waveIndex)\n        if (count > remaining) count = remaining\n        let tail = remaining - count\n        if (tail > 0 && tail <= 2 && count + tail <= GameConfig.MINION_WAVE_MAX_COUNT) count += tail\n        showWaveNotice(waveIndex + 1)\n        SoundSystem.minionWaveIncoming()\n        for (let i = 0; i < count; i++) {\n            let planIndex = stageSpawnedCount + i\n            let type = stagePlanTypes[planIndex]\n            let elite = stagePlanElites[planIndex]\n            spawn(type, elite, null, false, true, 0, waveIndex, StageSystem.getLevel(), false)\n        }\n        stageSpawnedCount += count\n        currentWaveOriginalCount = count\n        waveIndex += 1\n        nextWaveReadyAt = game.runtime() + count * GameConfig.MINION_WAVE_TIMER_PER_SLOT_MS\n    }\n    function rollElite(stage: number): boolean {\n        if (stage < 1) stage = 1\n        let chance = 5\n        if (stage <= 10) chance = 5 + Math.idiv((stage - 1) * 20, 9)\n        else chance = 25 + Math.idiv(stage - 10, 2)\n        if (chance > GameConfig.MINION_ELITE_CHANCE_CAP_PERCENT) chance = GameConfig.MINION_ELITE_CHANCE_CAP_PERCENT\n        return randint(1, 100) <= chance\n    }\n    let slimeGenerationImageCache: Image[] = []\n    function slimeGenerationImage(elite: boolean, generation: number, damageLevel: number): Image {\n        if (generation < 0) generation = 0\n        if (generation > GameConfig.MINION_SLIME_MAX_SPLIT_GENERATION) generation = GameConfig.MINION_SLIME_MAX_SPLIT_GENERATION\n        if (damageLevel < 0) damageLevel = 0; if (damageLevel > 3) damageLevel = 3\n        let generationCount = GameConfig.MINION_SLIME_MAX_SPLIT_GENERATION + 1\n        let cacheIndex = ((elite ? 1 : 0) * generationCount + generation) * 4 + damageLevel\n        if (slimeGenerationImageCache[cacheIndex] != null) return slimeGenerationImageCache[cacheIndex]\n        let size = elite ? 15 : 11\n        if (generation == 1) size -= 2\n        else if (generation == 2) size -= 4\n        else if (generation == 3) size -= 5\n        else if (generation >= 4) size -= 6\n        if (size < 7) size = 7\n        let out = image.create(size, size)\n        let mid = Math.idiv(size, 2)\n        let r = Math.max(2, mid - 1)\n        let color = generation == 0 ? 11 : (generation == 1 ? 7 : (generation == 2 ? 8 : (generation == 3 ? 6 : 5)))\n        if (elite) color = generation == 0 ? 2 : (generation == 1 ? 4 : (generation == 2 ? 10 : (generation == 3 ? 9 : 5)))\n        for (let y = mid - r + 1; y <= mid + r; y++) for (let x = mid - r; x <= mid + r; x++) {\n            let dx = x - mid, dy = y - (mid + 1)\n            if (dx * dx * 2 + dy * dy <= r * r * 2 + 2) out.setPixel(x, y, color)\n        }\n        out.setPixel(mid - 1, mid, 1); out.setPixel(mid + 1, mid, 1)\n        if (mid - 2 >= 0 && mid - 1 >= 0) out.setPixel(mid - 2, mid - 1, 1)\n        for (let x = Math.max(0, mid - r + 1); x <= Math.min(size - 1, mid + r - 1); x++)if ((x + generation) % 3 == 0) out.setPixel(x, Math.min(size - 1, mid + r), 15)\n        if (elite) { out.setPixel(1, 1, 5); out.setPixel(size - 2, 1, 5) }\n        if (damageLevel > 0) {\n            for (let y = 0; y < size; y++) for (let x = 0; x < size; x++) {\n                if (out.getPixel(x, y) == 0) continue\n                let edge = Math.min(Math.min(x, size - 1 - x), Math.min(y, size - 1 - y))\n                if (damageLevel >= 1 && edge == 0 && (x + y) % 3 == 0) out.setPixel(x, y, 0)\n                if (damageLevel >= 2 && edge <= 1 && (x * 2 + y) % 4 == 0) out.setPixel(x, y, 0)\n                if (damageLevel >= 3 && edge <= 2 && (x + y * 2) % 4 == 1) out.setPixel(x, y, 0)\n            }\n        }\n        slimeGenerationImageCache[cacheIndex] = out\n        return out\n    }\n    function minionSpawnImage(type: number, elite: boolean, generation: number): Image {\n        if (type == SLIME) return slimeGenerationImage(elite, generation, 0)\n        return GameAssets.minionImage(type, elite)\n    }\n    function registerMinionActorAt(type: number, elite: boolean, owner: Sprite, isSummoned: boolean, countsForTarget: boolean, splitGeneration: number, waveTier: number, difficultyStage: number, isBossSupport: boolean, x: number, y: number, readyAt: number, hiddenDuringTelegraph: boolean, isHardSummon?: boolean): Sprite {\n        let actorImage = minionSpawnImage(type, elite, splitGeneration).clone()\n        let actor = EnemyFramework.createWorldActor(actorImage, SpriteKind.Minion, x, y, GameConfig.BOSS_Z - 5)\n        let minX = MinionBehaviorShared.minX(actor), maxX = MinionBehaviorShared.maxX(actor), minY = MinionBehaviorShared.minY(actor), maxY = MinionBehaviorShared.maxY(actor)\n        actor.setPosition(clamp(x, minX, maxX), clamp(y, minY, maxY))\n        let weakenedSummon = isSummoned && owner != null && BossSystem.isDualBossStage()\n        let hp = calculateMinionHP(type, elite, weakenedSummon, waveTier, difficultyStage)\n        if (isHardSummon == true) hp = Math.max(1, Math.idiv(hp * GameConfig.SUMMONER_HARD_HP_PERCENT + 99, 100))\n        if (type == SLIME && splitGeneration > 0) {\n            let divisor = 1\n            for (let g = 0; g < splitGeneration; g++)divisor *= 2\n            hp = Math.max(1, Math.idiv(hp, divisor))\n        }\n        let runtime = new MinionRuntimeSystem.MinionRuntime(actor, type, elite, hp, owner, isSummoned, countsForTarget, splitGeneration, waveTier, difficultyStage, isBossSupport, readyAt, hiddenDuringTelegraph, isHardSummon == true)\n        let index = MinionRuntimeSystem.add(runtime)\n        if (hiddenDuringTelegraph) {\n            actor.setFlag(SpriteFlag.Invisible, true); actor.setFlag(SpriteFlag.Ghost, true)\n            createMinionSpawnEffect(actor, elite, runtime.spawnReadyAt)\n        } else {\n            actor.setFlag(SpriteFlag.Invisible, false); actor.setFlag(SpriteFlag.Ghost, false)\n            SoundSystem.minionMaterialize()\n        }\n        updateMinionHealthBar(index)\n        return actor\n    }\n    function spawn(type: number, elite: boolean, owner: Sprite, isSummoned: boolean, countsForTarget: boolean, splitGeneration: number, waveTier: number, difficultyStage: number, isBossSupport: boolean): Sprite {\n        if (owner == null) {\n            scheduleWorldSpawn(type, elite, countsForTarget, splitGeneration, waveTier, difficultyStage, isBossSupport)\n            return null\n        }\n        let preview = minionSpawnImage(type, elite, splitGeneration)\n        let halfW = Math.idiv(preview.width + 1, 2), halfH = Math.idiv(preview.height + 1, 2)\n        let minX = halfW + GameConfig.MINION_WORLD_ROUTE_MARGIN, maxX = GameConfig.WORLD_WIDTH - halfW - GameConfig.MINION_WORLD_ROUTE_MARGIN\n        let minY = halfH + GameConfig.MINION_WORLD_ROUTE_MARGIN, maxY = GameConfig.WORLD_HEIGHT - halfH - GameConfig.MINION_WORLD_ROUTE_MARGIN\n        let x = owner.x, y = owner.y\n        if (isSummoned) { let a = randint(0, 359) * Math.PI / 180, r = randint(36, 66); x = owner.x + Math.cos(a) * r; y = owner.y + Math.sin(a) * r }\n        else { x = owner.x + randint(-14, 14); y = owner.y + randint(-14, 14) }\n        x = clamp(x, minX, maxX); y = clamp(y, minY, maxY)\n        let born = game.runtime(), telegraphMs = splitGeneration > 0 ? 500 : 1400\n        return registerMinionActorAt(type, elite, owner, isSummoned, countsForTarget, splitGeneration, waveTier, difficultyStage, isBossSupport, x, y, born + t