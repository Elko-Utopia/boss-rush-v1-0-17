rue\n        if (type == WALKER && elite) return true\n        return false\n    }\n    export function affinityForBoss(type: number): number {\n        if (type == 1) return SPIDER\n        if (type == 2) return EYE\n        if (type == 3) return FLOWER\n        if (type == 4) return BEETLE\n        if (type == 5) return SLIME\n        return MASK\n    }\n}\nnamespace MinionRuntimeSystem {\n    export class MinionRuntime {\n        sprite: Sprite\n        type: number\n        elite: boolean\n        hp: number\n        maxHP: number\n        splitGeneration: number\n        healthBar: Sprite\n        nextAttackAt: number\n        bornAt: number\n        spawnReadyAt: number\n        spawnWaveTier: number\n        difficultyLevel: number\n        bossSupport: boolean\n        lastEliteTrailAt: number\n        lastEliteTrailX: number\n        lastEliteTrailY: number\n        stateA: number\n        stateB: number\n        burstVX: number\n        burstVY: number\n        visualFrame: number\n        lastVisualAt: number\n        ownerBoss: Sprite\n        summoned: boolean\n        hardSummoned: boolean\n        countsTowardStageTarget: boolean\n        hitResponseTargetX: number\n        hitResponseTargetY: number\n        hitResponseRemaining: number\n        hitResponseLastX: number\n        hitResponseLastY: number\n        attackVolleyCount: number\n        attackVolleyTarget: number\n        constructor(actor: Sprite, type: number, elite: boolean, hp: number, owner: Sprite, isSummoned: boolean, countsForTarget: boolean, splitGeneration: number, waveTier: number, difficultyStage: number, isBossSupport: boolean, readyAt: number, hiddenDuringTelegraph: boolean, isHardSummon: boolean) {\n            this.sprite = actor\n            this.type = type\n            this.elite = elite\n            this.hp = hp\n            this.maxHP = hp\n            this.splitGeneration = splitGeneration\n            this.healthBar = sprites.create(image.create(elite ? 17 : 13, 2), S