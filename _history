damage > 0) BossHybridSpecial.damage(core, damage, true)\n                bullet.destroy()\n            }\n        )\n        sprites.onOverlap(\n            SpriteKind.MissileExplosion,\n            SpriteKind.HybridCore,\n            function (explosion, core) {\n                if (!GameSession.isRunning()) return\n                let index = missileExplosionIndex(explosion)\n                if (index < 0 || missileExplosionAlreadyHit(index, core)) return\n                markMissileExplosionHit(index, core)\n                BossHybridSpecial.damage(core, 4, false)\n                destroyMissileExplosion(explosion)\n            }\n        )\n        sprites.onOverlap(\n            SpriteKind.PlayerCore,\n            SpriteKind.Minion,\n            function (core, enemy) {\n                if (!GameSession.isRunning()) return\n                if (ShieldSystem.isProtectingPlayer()) return\n                PlayerSystem.damage()\n                MinionSystem.knockBack(enemy)\n            }\n        )\n        sprites.onOverlap(\n            SpriteKind.PlayerCore,\n            SpriteKind.BossBullet,\n            function (core, bullet) {\n                if (!GameSession.isRunning() || BossSystem.isAwaitingStageConfirm()) {\n                    return\n                }\n                if (!enemyBulletCoreHit(core, bullet)) return\n                GrazeSystem.markHit(bullet)\n                if (!BulletPatternSystem.isMegaBullet(bullet)) bullet.destroy()\n                if (ShieldSystem.isProtectingPlayer()) {\n                    return\n                }\n                PlayerSystem.damage()\n            }\n        )\n        sprites.onOverlap(\n            SpriteKind.PlayerCore,\n            SpriteKind.HybridCore,\n            function (playerCore, hybridCore) {\n                if (!GameSession.isRunning()) return\n                if (ShieldSystem.isProtectingPlayer()) return\n                PlayerSystem.damage()\n            }\n        )\n        sprites.onOverlap(\n            SpriteKind.PlayerCore,\n            SpriteKind.Enemy,\n            function (core, enemy) {\n                if (!GameSession.isRunning()) {\n                    return\n                }\n                if (ShieldSystem.isProtectingPlayer()) {\n                    return\n                }\n                PlayerSystem.damage()\n            }\n        )\n        sprites.onOverlap(SpriteKind.MissileExplosion, SpriteKind.Enemy, function (explosion, enemy) {\n            if (!GameSession.isRunning()) return\n            let i = missileExplosionIndex(explosion)\n            if (i < 0 || missileExplosionAlreadyHit(i, enemy)) return\n            markMissileExplosionHit(i, enemy)\n            SoundSystem.projectileTargetHurt(BossSystem.getEnemyTypeForSprite(enemy), true)\n            BossSystem.damageEnemy(enemy, 4)\n        })\n        sprites.onOverlap(SpriteKind.MissileExplosion, SpriteKind.Minion, function (explosion, enemy) {\n            if (!GameSession.isRunning()) return\n            let i = missileExplosionIndex(explosion)\n            if (i < 0 || missileExplosionAlreadyHit(i, enemy)) return\n            markMissileExplosionHit(i, enemy)\n            SoundSystem.projectileTargetHurt(MinionSystem.getEnemyType(enemy), false)\n            MinionSystem.damageEnemy(enemy, 4)\n        })\n        GameUpdateScheduler.every(GameConfig.REFRESH_COMBAT_MS, function () { updateMissileExplosions() })\n        GameUpdateScheduler.every(GameConfig.BULLET_FLASH_INTERVAL_MS, function () {\n            updateBulletCenters()\n        })\n        GameUpdateScheduler.every(GameConfig.PLAYER_HOMING_MISSILE_STEER_INTERVAL_MS, function () {\n            updateHomingMissiles()\n        })\n        sprites.onDestroyed(SpriteKind.PlayerBullet, function (bullet) {\n            forgetHomingMissile(bullet)\n            forgetNeedleBullet(bullet)\n        })\n    }\n    export function fireNormalAtTarget(target: Sprite) {\n        if (!GameSession.isRunning() || PlayerSystem.isRespawning() || target == null) return\n        let player = PlayerSystem.getPlayer()\n        if (player == null) return\n        fireStraightDirection(player, target.x - player.x, target.y - player.y, GameConfig.PLAYER_BULLET_SPEED, false)\n    }\n    export function fireMissileCycle(target: Sprite, directionX: number, directionY: number) {\n        if (!GameSession.isRunning() || PlayerSystem.isRespawning()) return\n        let player = PlayerSystem.getPlayer()\n        if (player == null) return\n        if (target != null) {\n            fireAtTarget(player, target)\n            return\n        }\n        if (directionX == 0 && directionY == 0) { directionX = 0; directionY = -1 }\n        let mag = Math.sqrt(directionX * directionX + directionY * directionY)\n        if (mag <= 0) return\n        let speed = GameConfig.PLAYER_BULLET_SPEED * GameConfig.PLAYER_HOMING_MISSILE_SPEED_MULTIPLIER\n        createPlayerBullet(player, directionX / mag * speed, directionY / mag * speed, false, true, null, true)\n    }\n    export function fireNeedleRewardMissile(directionX: number, directionY: number) {\n        if (!GameSession.isRunning() || PlayerSystem.isRespawning()) return\n        if (directionX == 0 && directionY == 0) return\n        let player = PlayerSystem.getPlayer(); if (player == null) return\n        let mag = Math.sqrt(directionX * directionX + directionY * directionY); if (mag <= 0) return\n        let nx = directionX / mag, ny = directionY / mag\n        let speed = GameConfig.PLAYER_BULLET_SPEED * GameConfig.PLAYER_HOMING_MISSILE_SPEED_MULTIPLIER\n        let target = TargetSystem.getTarget()\n        createPlayerBullet(player, nx * speed, ny * speed, false, true, target, target == null)\n    }\n    export function firePlayerBullet() {\n        if (!GameSession.isRunning() || PlayerSystem.isRespawning()) {\n            return\n        }\n        let player = PlayerSystem.getPlayer()\n        let directionX = PlayerSystem.getCurrentDirectionX()\n        let directionY = PlayerSystem.getCurrentDirectionY()\n        if (PlayerSystem.isFastAttackActive()) {\n            if (directionX == 0 && directionY == 0) {\n                directionX = PlayerSystem.getLastDirectionX()\n                directionY = PlayerSystem.getLastDirectionY()\n            }\n            if (directionX != 0 || directionY != 0) {\n                fireStraightDirection(\n                    player,\n                    PlayerSystem.getVisualAimX(),\n                    PlayerSystem.getVisualAimY(),\n                    GameConfig.PLAYER_BULLET_SPEED * GameConfig.PLAYER_B_HELD_BULLET_SPEED_MULTIPLIER,\n                    true\n                )\n            }\n            return\n        }\n        if (directionX != 0 || directionY != 0) {\n            fireStraightDirection(\n                player,\n                PlayerSystem.getVisualAimX(),\n                PlayerSystem.getVisualAimY(),\n                GameConfig.PLAYER_BULLET_SPEED,\n                false\n            )\n            return\n        }\n        let target = TargetSystem.getTarget()\n        if (target != null) {\n            fireAtTarget(player, target)\n            return\n        }\n        directionX = PlayerSystem.getLastDirectionX()\n        directionY = PlayerSystem.getLastDirectionY()\n        if (directionX != 0 || directionY != 0) {\n            fireStraightDirection(\n                player,\n                directionX,\n                directionY,\n                GameConfig.PLAYER_BULLET_SPEED,\n                false\n            )\n        }\n    }\n    function fireAtTarget(player: Sprite, target: Sprite) {\n        let dx = target.x - player.x, dy = target.y - player.y\n        if (dx == 0 && dy == 0) return\n        let angle = Math.atan2(dy, dx)\n        angle += randint(-GameConfig.PLAYER_HOMING_MISSILE_INITIAL_SPREAD_DEG, GameConfig.PLAYER_HOMING_MISSILE_INITIAL_SPREAD_DEG) * Math.PI / 180\n        let speed = GameConfig.PLAYER_BULLET_SPEED * GameConfig.PLAYER_HOMING_MISSILE_SPEED_MULTIPLIER\n        createPlayerBullet(player, Math.cos(angle) * speed, Math.sin(angle) * speed, false, true, target)\n    }\n    function fireStraightDirection(player: Sprite, directionX: number, directionY: number, bulletSpeed: number, fastMode: boolean) {\n        if (directionX == 0 && directionY == 0) return\n        let angle = Math.atan2(directionY, directionX)\n        let spreadDeg = fastMode ? GameConfig.PLAYER_NEEDLE_SHOT_SPREAD_DEG : GameConfig.PLAYER_STRAIGHT_SHOT_SPREAD_DEG\n        angle += randint(-spreadDeg * 10, spreadDeg * 10) * Math.PI / 1800\n        createPlayerBullet(player, Math.cos(angle) * bulletSpeed, Math.sin(angle) * bulletSpeed, fastMode, false, null)\n    }\n    function createPlayerBullet(player: Sprite, vx: number, vy: number, fastMode: boolean, missileMode: boolean, target: Sprite, seekWhenClose?: boolean) {\n        let bulletImage = GameAssets.playerBulletNormal()\n        if (fastMode) bulletImage = GameAssets.playerNeedle(vx, vy)\n        else if (missileMode) bulletImage = GameAssets.playerMissile(vx, vy)\n        let bullet = sprites.createProjectileFromSprite(bulletImage, player, vx, vy)\n        bullet.setKind(SpriteKind.PlayerBullet)\n        bullet.z = GameConfig.PLAYER_BULLET_Z\n        bullet.setFlag(SpriteFlag.AutoDestroy, false)\n        bullet.lifespan = GameConfig.PLAYER_PROJECTILE_MAX_LIFETIME_MS\n        if (!missileMode) {\n            let mag = Math.sqrt(vx * vx + vy * vy)\n            if (mag > 0) {\n                let nx = vx / mag, ny = vy / mag\n                let playerRadius = Math.idiv(Math.max(player.width, player.height), 2)\n                let muzzle = playerRadius + 4\n                bullet.setPosition(player.x + nx * muzzle, player.y + ny * muzzle)\n            }\n        }\n        if (fastMode) {\n            registerNeedleBullet(bullet, player.x, player.y)\n            showNeedleMuzzleFlash(bullet.x, bullet.y, vx, vy)\n        }\n        if (missileMode) { registerHomingMissile(bullet, target, seekWhenClose == true); PlayerSystem.applyMissileRecoil(vx, vy); SoundSystem.playerMissileLaunch() }\n        else SoundSystem.playerShot(fastMode)\n    }\n    function registerHomingMissile(missile: Sprite, target: Sprite, seekWhenClose: boolean) {\n        homingMissiles.push(missile); homingTargets.push(target); homingSeekWhenClose.push(seekWhenClose)\n        homingAimAngles.push(Math.atan2(missile.vy, missile.vx))\n        homingTrailX.push(missile.x); homingTrailY.push(missile.y); homingTrailAt.push(game.runtime())\n    }\n    function removeHomingMissileAt(i: number) {\n        if (i < 0 || i >= homingMissiles.length) return\n        let last = homingMissiles.length - 1\n        if (i != last) {\n            homingMissiles[i] = homingMissiles[last]; homingTargets[i] = homingTargets[last]; homingSeekWhenClose[i] = homingSeekWhenClose[last]; homingAimAngles[i] = homingAimAngles[last]\n            homingTrailX[i] = homingTrailX[last]; homingTrailY[i] = homingTrailY[last]; homingTrailAt[i] = homingTrailAt[last]\n        }\n        homingMissiles.pop(); homingTargets.pop(); homingSeekWhenClose.pop(); homingAimAngles.pop(); homingTrailX.pop(); homingTrailY.pop(); homingTrailAt.pop()\n    }\n    function forgetHomingMissile(missile: Sprite) {\n        for (let i = homingMissiles.length - 1; i >= 0; i--)if (homingMissiles[i] == missile) { removeHomingMissileAt(i); return }\n    }\n    function updateMissileTrail(i: number, missile: Sprite, now: number) {\n        if (i < 0 || i >= homingTrailAt.length || missile == null) return\n        if (now - homingTrailAt[i] < GameConfig.PLAYER_MISSILE_TRAIL_SAMPLE_MS) return\n        let x0 = homingTrailX[i], y0 = homingTrailY[i], x1 = missile.x, y1 = missile.y\n        homingTrailX[i] = x1; homingTrailY[i] = y1; homingTrailAt[i] = now\n        let dx = x1 - x0, dy = y1 - y0; if (dx * dx + dy * dy < 0.04) return\n        TrailRibbonSystem.spawnSimpleSegment(missile, SpriteKind.MinionEffect, x0, y0, x1, y1, 0.40, 0.40, 5, GameConfig.PLAYER_MISSILE_TRAIL_DURATION_MS, GameConfig.PLAYER_BULLET_Z - 1, false)\n    }\n    function nearestMissileTarget(missile: Sprite, maxRadius: number): Sprite {\n        let best: Sprite = null\n        let bestD = maxRadius * maxRadius\n        for (let i = 0; i < EnemyRegistrySystem.count(); i++) {\n            let t = EnemyRegistrySystem.actorAt(i); if (t == null) continue\n            let dx = t.x - missile.x, dy = t.y - missile.y\n            let d = dx * dx + dy * dy\n            if (d <= bestD) { bestD = d; best = t }\n        }\n        return best\n    }\n    function updateHomingMissiles() {\n        if (homingMissiles.length <= 0) return\n        let now = game.runtime()\n        let baseTurn = GameConfig.PLAYER_HOMING_MISSILE_MAX_TURN_DEG * Math.PI / 180\n        let speed = GameConfig.PLAYER_BULLET_SPEED * GameConfig.PLAYER_HOMING_MISSILE_SPEED_MULTIPLIER\n        for (let i = homingMissiles.length - 1; i >= 0; i--) {\n            let missile = homingMissiles[i]\n            if (missile == null) { removeHomingMissileAt(i); continue }\n            updateMissileTrail(i, missile, now)\n            let target = homingTargets[i]\n            let seekClose = homingSeekWhenClose[i]\n            if (target == null && seekClose) {\n                target = nearestMissileTarget(missile, GameConfig.AUTO_LOCK_RADIUS)\n                if (target != null) { homingTargets[i] = target; homingSeekWhenClose[i] = false }\n            } else if (!EnemyRegistrySystem.isMissileTarget(target)) {\n                let radius = seekClose ? GameConfig.AUTO_LOCK_RADIUS : 180\n                target = nearestMissileTarget(missile, radius); homingTargets[i] = target\n                if (target != null) homingSeekWhenClose[i] = false\n            }\n            if (target == null) continue\n            let dx = target.x - missile.x, dy = target.y - missile.y\n            let dist = Math.sqrt(dx * dx + dy * dy)\n            let leadMs = dist > 70 ? 180 : (dist > 36 ? 110 : 45)\n            let aimX = target.x + target.vx * leadMs / 1000\n            let aimY = target.y + target.vy * leadMs / 1000\n            let rawDesired = Math.atan2(aimY - missile.y, aimX - missile.x)\n            let filteredDesired = homingAimAngles[i]\n            if (filteredDesired == null) filteredDesired = Math.atan2(missile.vy, missile.vx)\n            let aimDiff = rawDesired - filteredDesired\n            while (aimDiff > Math.PI) aimDiff -= Math.PI * 2\n            while (aimDiff < 0 - Math.PI) aimDiff += Math.PI * 2\n            let aimStep = baseTurn * 1.8\n            if (aimDiff > aimStep) aimDiff = aimStep\n            if (aimDiff < 0 - aimStep) aimDiff = 0 - aimStep\n            filteredDesired += aimDiff\n            homingAimAngles[i] = filteredDesired\n            let current = Math.atan2(missile.vy, missile.vx)\n            let diff = filteredDesired - current\n            while (diff > Math.PI) diff -= Math.PI * 2\n            while (diff < 0 - Math.PI) diff += Math.PI * 2\n            let maxTurn = baseTurn\n            if (dist < 42) maxTurn = baseTurn * 1.35\n            else if (dist < 72) maxTurn = baseTurn * 1.15\n            if (diff > maxTurn) diff = maxTurn\n            if (diff < 0 - maxTurn) diff = 0 - maxTurn\n            let next = current + diff\n            missile.vx = Math.cos(next) * speed; missile.vy = Math.sin(next) * speed\n            missile.setImage(GameAssets.playerMissile(missile.vx, missile.vy))\n        }\n    }\n    function updateBulletCenters() {\n        bulletCenterWhite = !bulletCenterWhite\n        let color = 15\n        if (bulletCenterWhite) {\n            color = 1\n        }\n        let bossBullets = sprites.allOfKind(SpriteKind.BossBullet)\n        let touchedCount = 0\n        for (let bullet of bossBullets) {\n            if (bullet == null || !WorldSystem.isSpriteOnCamera(bullet, 0)) continue\n            if (BulletPatternSystem.isMegaBullet(bullet)) continue\n            let img = bullet.image\n            if (img == null || img.width > 3 || img.height > 3) continue\n            let alreadyTouched = false\n            for (let j = 0; j < touchedCount; j++)if (bulletCenterTouchedImages[j] == img) { alreadyTouched = true; break }\n            if (alreadyTouched) continue\n            if (touchedCount < bulletCenterTouchedImages.length) bulletCenterTouchedImages[touchedCount] = img\n            else bulletCenterTouchedImages.push(img)\n            touchedCount += 1\n            img.setPixel(Math.idiv(img.width, 2), Math.idiv(img.height, 2), color)\n        }\n        while (bulletCenterTouchedImages.length > touchedCount) bulletCenterTouchedImages.pop()\n    }\n}\nnamespace GameBlocks {\n    export function startGame(): void {\n        GameSession.initialize()\n    }\n    export function stopGame(): void {\n        GameSession.stop()\n    }\n    export function isRunning(): boolean {\n        return GameSession.isRunning()\n    }\n}\nnamespace StageBlocks {\n    export function currentStage(): number {\n        return StageSystem.getLevel()\n    }\n    export function advanceStage(): void {\n        StageSystem.advance()\n    }\n}\nnamespace PlayerBlocks {\n    export function hp(): number {\n        return PlayerSystem.getHP()\n    }\n    export function restoreFullHealth(): void {\n        PlayerSystem.restoreFullHealth()\n    }\n    export function damagePlayer(): void {\n        PlayerSystem.damage()\n    }\n}\nnamespace BossBlocks {\n    export function hp(): number {\n        return BossSystem.getHP()\n    }\n    export function maxHP(): number {\n        return BossSystem.getMaxHP()\n    }\n    export function alive(): boolean {\n        return BossSystem.isAlive()\n    }\n    export function movementMode(): number {\n        return BossSystem.getMovementMode()\n    }\n    export function damageBoss(amount: number): void {\n        BossSystem.damage(amount)\n    }\n}\nnamespace ShieldBlocks {\n    export function releaseShield(): void {\n        ShieldSystem.releaseShield()\n    }\n    export function isReady(): boolean {\n        return ShieldSystem.isReady()\n    }\n    export function cooldownProgress(): number {\n        return ShieldSystem.getCooldownProgress1000()\n    }\n}\nnamespace CombatBlocks {\n    export function firePlayerBullet(): void {\n        CombatSystem.firePlayerBullet()\n    }\n    export function hasTarget(): boolean {\n        return TargetSystem.peekTarget() != null\n    }\n}\nnamespace ScoreBlocks {\n    export function total(): number {\n        return ScoreSystem.getScore()\n    }\n    export function lastGain(): number {\n        return ScoreSystem.getLastGain()\n    }\n    export function lastTimeBonus(): number {\n        return ScoreSystem.getLastTimeBonus()\n    }\n}\nGameSession.initialize()\n","README.md":" \n\n\n> Open this page at [https://elko-utopia.github.io/boss-rush-v0286/](https://elko-utopia.github.io/boss-rush-v0286/)\n\n## Use as Extension\n\nThis repository can be added as an **extension** in MakeCode.\n\n* open [https://arcade.makecode.com/](https://arcade.makecode.com/)\n* click on **New Project**\n* click on **Extensions** under the gearwheel menu\n* search for **https://github.com/elko-utopia/boss-rush-v0286** and import\n\n## Edit this project\n\nTo edit this repository in MakeCode.\n\n* open [https://arcade.makecode.com/](https://arcade.makecode.com/)\n* click on **Import** then click on **Import URL**\n* paste **https://github.com/elko-utopia/boss-rush-v0286** and click import\n\n#### Metadata (used for search, rendering)\n\n* for PXT/arcade\n<script src=\"https://makecode.com/gh-pages-embed.js\"></script><script>makeCodeRender(\"{{ site.makecode.home_url }}\", \"{{ site.github.owner_name }}/{{ site.github.repository_name }}\");</script>\n","assets.json":"","pxt.json":"{\n    \"name\": \"Boss Rush V1.0.17\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blo