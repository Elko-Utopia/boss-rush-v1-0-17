p.x > a.x ? 1 : -1) * speed }\n        steerVelocity(a, tx, ty, 0.16)\n    }\n    export function wander(r: MinionRuntimeSystem.MinionRuntime, speed: number) {\n        let phase = (game.runtime() + r.stateA * 31) * Math.PI / 1800\n        steerVelocity(r.sprite, Math.cos(phase) * speed, Math.sin(phase * 0.83) * speed, 0.10)\n    }\n    export function nudgeBackFromWorldEdge(a: Sprite, speed: number) {\n        if (a == null) return\n        let edge = 10, tx = a.vx, ty = a.vy, needs = false\n        if (a.x < edge) { tx = Math.max(tx, speed); needs = true }\n        else if (a.x > GameConfig.WORLD_WIDTH - edge) { tx = Math.min(tx, -speed); needs = true }\n        if (a.y < edge) { ty = Math.max(ty, speed); needs = true }\n        else if (a.y > GameConfig.WORLD_HEIGHT - edge) { ty = Math.min(ty, -speed); needs = true }\n        if (needs) steerVelocity(a, tx, ty, 0.18)\n    }\n    export function scaledAttackCooldown(baseMs: number, waveTier: number, difficultyStage: number): number {\n        let stage = EnemyFramework.clampStage30(difficultyStage)\n        let stageReduce = Math.idiv((stage - 1) * 18, 29)\n        let reduce = Math.max(0, waveTier) * 5 + stageReduce\n        if (reduce > 45) reduce = 45\n        return Math.idiv(baseMs * (100 - reduce), 100)\n    }\n    export function scheduleNextAttack(r: MinionRuntimeSystem.MinionRuntime, now: number, normalCooldown: number): number {\n        if (r == null || r.sprite == null) return now + Math.max(1, normalCooldown)\n        if (r.hardSummoned) normalCooldown = Math.max(1, Math.idiv(normalCooldown * GameConfig.SUMMONER_HARD_ATTACK_INTERVAL_PERCENT, 100))\n        if (r.attackVolleyTarget <= 0) r.attackVolleyTarget = randint(GameConfig.MINION_ATTACK_BURST_MIN, GameConfig.MINION_ATTACK_BURST_MAX)\n        r.attackVolleyCount += 1\n        let extraRest = 0\n        if (r.attackVolleyCount >= r.attackVolleyTarget) {\n            r.attackVolleyCount = 0\n            r.attackVolleyTarget = randint(GameConfig.MINI