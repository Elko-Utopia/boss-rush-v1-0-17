     intervalValues.push(intervalMs)\n            intervalNextAts.push(game.runtime() + intervalMs)\n            intervalHandlers.push([])\n        }\n        intervalHandlers[index].push(handler)\n    }\n    function tick() {\n        for (let i = 0; i < frameHandlers.length; i++)frameHandlers[i]()\n        let now = game.runtime()\n        for (let bucket = 0; bucket < intervalValues.length; bucket++) {\n            if (now < intervalNextAts[bucket]) continue\n            let handlers = intervalHandlers[bucket]\n            for (let i = 0; i < handlers.length; i++)handlers[i]()\n            let next = intervalNextAts[bucket] + intervalValues[bucket]\n            if (next <= now) next = now + intervalValues[bucket]\n            intervalNextAts[bucket] = next\n        }\n    }\n}\nnamespace BossTimerSystem {\n    export function millisecondsPerBossHP(stage: number): number {\n        let s = stage\n        if (s < 1) s = 1\n        if (s > GameConfig.BOSS_MAX_DIFFICULTY_LEVEL) s = GameConfig.BOSS_MAX_DIFFICULTY_LEVEL\n        let start = GameConfig.SCORE_TIME_LIMIT_MS_PER_BOSS_HP_STAGE1\n        let end = GameConfig.SCORE_TIME_LIMIT_MS_PER_BOSS_HP_STAGE30\n        if (GameConfig.BOSS_MAX_DIFFICULTY_LEVEL <= 1) return end\n        return start - Math.idiv((s - 1) * (start - end), GameConfig.BOSS_MAX_DIFFICULTY_LEVEL - 1)\n    }\n    export function limitMs(totalBossHP: number, stage: number): number {\n        if (totalBossHP <= 0) return 0\n        return totalBossHP * millisecondsPerBossHP(stage)\n    }\n}\nnamespace MusicSystem {\n    const BGM_NONE = 0\n    const BGM_MINION_CELESTIAL = 1\n    const BGM_MINION_POLARIS = 2\n    const BGM_MINION_RUDER = 3\n    const BGM_MINION_FAREWELL = 4\n    const BGM_BOSS_LASER = 10\n    const BGM_BOSS_RUSH = 11\n    const BGM_BOSS_SUMMONER = 12\n    const BGM_BOSS_DUAL = 13\n    const BGM_BOSS_HYBRID = 14\n    const BGM_BOSS_WALL = 15\n    const BGM_BOSS_DANMAKU = 16\n    const BGM_TITLE_HYBRID = 17\n    const MASTER_VOLUME = 6